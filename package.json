{
  "name": "moneylook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node scripts/svg-to-png.mjs && node scripts/generate-llms.mjs && pnpm pagefind",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check && tsc --noEmit",
    "pagefind": "pagefind --site dist --output-subdir pagefind",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "go-live": "node scripts/go-live-check.mjs",
    "validate:schema": "node scripts/validate-schema.mjs",
    "audit:geo": "node scripts/geo-audit.mjs",
    "article": "node scripts/article-pipeline.mjs",
    "refine": "node scripts/refine-existing.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "secrets:scan": "node scripts/secrets-scan.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/react": "^5.0.4",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@sentry/browser": "^10.51.0",
    "astro": "^6.2.0",
    "pretendard": "^1.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "web-vitals": "^5.2.0"
  },
  "devDependencies": {
    "@astrojs/partytown": "^2.1.7",
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.59.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitest/coverage-v8": "^4.1.5",
    "happy-dom": "^20.9.0",
    "pagefind": "^1.4.0",
    "satori": "^0.26.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.5"
  }
}
