---
/**
 * 반응형 이미지 헬퍼 — astro:assets `<Picture>` 래퍼
 *
 * 사용:
 *   import heroImg from '@/assets/articles/hero.jpg';
 *   <ResponsivePicture src={heroImg} alt="..." sizes="(min-width: 768px) 720px, 100vw" priority={true} />
 *
 * - AVIF + WebP + JPEG 폴백 자동
 * - lazy loading + fetchpriority 제어
 * - width/height 명시로 CLS 0
 * - quality 75 (AVIF) / 78 (WebP) / 80 (JPEG)
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  priority?: boolean;
  class?: string;
  width?: number;
  height?: number;
}

const {
  src,
  alt,
  sizes = '(min-width: 768px) 720px, 100vw',
  priority = false,
  class: className,
  width,
  height,
} = Astro.props;
---
<Picture
  src={src}
  alt={alt}
  sizes={sizes}
  formats={['avif', 'webp']}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding="async"
  width={width}
  height={height}
  class={className}
  pictureAttributes={{ class: 'rp-picture' }}
/>

<style is:global>
.rp-picture { display: block; line-height: 0; }
.rp-picture img { width: 100%; height: auto; max-width: 100%; }
</style>
