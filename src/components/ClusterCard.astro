---
import type { Cluster } from '../data/clusters';
import { clusterAccentDark } from '../data/clusters';
import ClusterIcon from './ClusterIcon.astro';

interface Props {
  cluster: Cluster;
}
const { cluster } = Astro.props;
const accentDark = clusterAccentDark(cluster.accent);
---
<a class="cluster-card" href={`/${cluster.slug}/`} style={`--accent-light: ${cluster.accent}; --accent-dark: ${accentDark}`}>
  <div class="icon-chip" aria-hidden="true">
    <ClusterIcon cluster={cluster.slug} size={22} />
  </div>
  <div class="body">
    <h3>{cluster.title}</h3>
    <p>{cluster.description}</p>
    <span class="cta">바로가기 →</span>
  </div>
</a>

<style>
.cluster-card {
  --accent: var(--accent-light);
  display: flex;
  gap: 0.85rem;
  padding: 1rem 1.1rem;
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-card);
  transition: transform 150ms cubic-bezier(0,0,0.2,1), border-color 150ms;
  position: relative;
  overflow: hidden;
}
.cluster-card::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, color-mix(in oklab, var(--accent) 6%, transparent) 0%, transparent 60%);
  pointer-events: none;
  opacity: 0;
  transition: opacity 200ms;
}
.cluster-card:hover {
  transform: translateY(-2px);
  border-color: var(--accent);
}
.cluster-card:hover::before { opacity: 1; }
[data-theme="dark"] .cluster-card { --accent: var(--accent-dark); }
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) .cluster-card { --accent: var(--accent-dark); }
}
.icon-chip {
  width: 40px;
  height: 40px;
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  background: color-mix(in oklab, var(--accent) 12%, transparent);
  color: var(--accent);
}
.body { flex: 1; min-width: 0; }
.body h3 {
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--color-secondary);
  margin: 0 0 0.25rem;
  letter-spacing: -0.025em;
}
.body p {
  font-size: 0.8rem;
  line-height: 1.55;
  color: var(--color-muted);
  margin: 0 0 0.4rem;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.cta {
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--accent);
}
</style>
