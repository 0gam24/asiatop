---
import { clusters } from '../data/clusters';
---
<header class="site-header">
  <div class="container">
    <a href="/" class="brand" aria-label="머니룩 홈">
      <span class="brand-text">머니룩</span>
      <span class="brand-dot" aria-hidden="true"></span>
    </a>
    <nav aria-label="주요 카테고리" class="nav-primary">
      <ul>
        {clusters.slice(0, 6).map((c) => (
          <li>
            <a href={`/${c.slug}/`}>{c.shortTitle}</a>
          </li>
        ))}
        <li><a href="/clusters/" class="nav-more">전체 +</a></li>
      </ul>
    </nav>
    <button type="button" class="theme-toggle" aria-label="테마 전환" data-theme-toggle>
      <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"/>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
      </svg>
      <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
    </button>
    <a href="/search/" rel="nofollow" class="header-search" aria-label="검색" data-track="header_search_click">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/>
        <path d="m21 21-4.3-4.3"/>
      </svg>
    </a>
    <a href="/calculators/salary/" class="header-cta" data-astro-reload data-track="header_cta_click" data-track-prop-target="salary_calculator">실수령 계산기</a>
  </div>
</header>

<style>
.site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: color-mix(in oklab, var(--color-bg) 92%, transparent);
  backdrop-filter: saturate(180%) blur(8px);
  -webkit-backdrop-filter: saturate(180%) blur(8px);
  border-bottom: 1px solid var(--color-border);
}
.site-header .container {
  display: flex;
  align-items: center;
  gap: 1rem;
  height: 56px;
  max-width: 1200px;
  padding-inline: 1rem;
  margin-inline: auto;
}
.brand {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  font-weight: 800;
  font-size: 1.125rem;
  color: var(--color-secondary);
  letter-spacing: -0.03em;
}
.brand-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--color-primary);
}
.nav-primary {
  flex: 1;
  overflow-x: auto;
  scrollbar-width: none;
}
.nav-primary::-webkit-scrollbar { display: none; }
.nav-primary ul {
  display: flex;
  gap: 0.25rem;
  list-style: none;
  margin: 0;
  padding: 0;
  white-space: nowrap;
}
.nav-primary a {
  display: inline-flex;
  align-items: center;
  height: 36px;
  padding-inline: 0.6rem;
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--color-text);
  border-radius: 6px;
}
.nav-primary a:hover {
  background: var(--color-surface);
  color: var(--color-primary-700);
}
.nav-primary .nav-more { color: var(--color-muted); }
.theme-toggle, .header-search {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  color: var(--color-secondary);
  flex-shrink: 0;
  background: transparent;
  border: 0;
  padding: 0;
  cursor: pointer;
}
.theme-toggle:hover, .header-search:hover { background: var(--color-surface); color: var(--color-primary-700); }
.theme-toggle .icon-moon { display: none; }
:root[data-theme="dark"] .theme-toggle .icon-sun { display: none; }
:root[data-theme="dark"] .theme-toggle .icon-moon { display: block; }
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) .theme-toggle .icon-sun { display: none; }
  :root:not([data-theme="light"]) .theme-toggle .icon-moon { display: block; }
}
.header-cta {
  display: inline-flex;
  align-items: center;
  height: 36px;
  padding-inline: 0.85rem;
  font-size: 0.85rem;
  font-weight: 600;
  background: var(--color-primary);
  color: var(--color-on-primary);
  border-radius: var(--radius-btn);
  white-space: nowrap;
}
.header-cta:hover { background: var(--color-primary-600); }

@media (max-width: 767px) {
  .nav-primary { display: none; }
}
</style>
