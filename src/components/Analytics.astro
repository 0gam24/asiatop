---
const ga4Id = import.meta.env.PUBLIC_GA4_ID;
---
{ga4Id && (
  <>
    <!-- GA4 — Consent Mode v2 default 는 Base.astro head 최상단에서 선실행됨
         (ga4Id 게이트 밖 — AdSense 단독 주입 시에도 consent 신호 보장, docs/23 §3-1 (2)).
         gtag.js 는 메인스레드 유휴 시점 주입 (Sentry 로더와 동일 패턴).
         Partytown 워커 주입은 2026-06-12 제거 — gtag 공식 미지원 조합인 데다
         config 호출이 포워딩 스니펫보다 먼저 실행돼 워커에 전달되지 않아 수신 0건
         (AdSense 와 같은 결정, docs/23 R3). -->
    <script is:inline define:vars={{ ga4Id }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
      gtag('js', new Date());
      // 페이지뷰는 astro:page-load 에서 일원화 전송 — ClientRouter 소프트
      // 내비게이션도 집계 (send_page_view:true 는 최초 로드만 잡는다)
      gtag('config', ga4Id, { send_page_view: false, anonymize_ip: true });

      if (!window.__ga4Init) {
        window.__ga4Init = true;

        document.addEventListener('astro:page-load', () => {
          window.gtag('event', 'page_view', {
            page_location: location.href,
            page_title: document.title,
          });
        });

        const loadGtag = () => {
          const s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4Id;
          document.head.appendChild(s);
        };
        if (typeof window.requestIdleCallback === 'function') {
          window.requestIdleCallback(loadGtag, { timeout: 3000 });
        } else {
          setTimeout(loadGtag, 1500);
        }
      }
    </script>
  </>
)}

<!-- AdSense Partytown 로더는 2026-06-12 제거 (docs/23 R3) — 공식 미지원 조합인 데다
     client 파라미터에 ca- 접두사가 누락돼 있었고, Base.astro head 로더와 이중 로드 상태였음.
     AdSense 로더는 Base.astro 의 메인스레드 단일 로더만 사용한다. -->

<!-- 네이버 애널리틱스 (2026-07-20 등록) — wcslog.js 는 GA4 gtag 와 동일하게
     메인스레드 유휴 시점 주입 (Lighthouse 100 가드). wa ID 는 페이지 소스에
     노출되는 공개 값이라 하드코딩. ClientRouter 소프트 내비게이션은
     astro:page-load 에서 wcs_do() 재호출로 집계하고, 같은 URL 이중 전송은
     lastSent 가드로 차단 (초기 로드는 onload 1회 전송). -->
<script is:inline>
  (() => {
    if (window.__naverWcsInit) return;
    window.__naverWcsInit = true;

    // 프로덕션 도메인에서만 로드 — CI lighthouse(localhost)의 third-party-cookies
    // 게이트 실패 방지 + dev·CF 프리뷰 자기 방문이 통계에 잡히는 것 차단.
    if (location.hostname !== 'asiatop.co.kr') return;

    window.wcs_add = window.wcs_add || {};
    window.wcs_add['wa'] = '1b52cc7b9c96b70';

    let lastSent = '';
    const send = () => {
      if (!window.wcs || typeof window.wcs_do !== 'function') return;
      if (location.href === lastSent) return;
      lastSent = location.href;
      window.wcs_do();
    };

    document.addEventListener('astro:page-load', send);

    const loadWcs = () => {
      const s = document.createElement('script');
      s.async = true;
      s.src = 'https://wcs.pstatic.net/wcslog.js';
      s.onload = send;
      document.head.appendChild(s);
    };
    if (typeof window.requestIdleCallback === 'function') {
      window.requestIdleCallback(loadWcs, { timeout: 3000 });
    } else {
      setTimeout(loadWcs, 1500);
    }
  })();
</script>

<!--
  Site-wide click tracking helper.
  ClientRouter swap 시 inline script가 다시 실행되므로 단일 등록 가드 필수
  (없으면 페이지 이동마다 listener 누적 → GA 이벤트가 N배 전송됨).
-->
<script is:inline>
  (() => {
    if (window.__trackClickInit) return;
    window.__trackClickInit = true;
    document.addEventListener('click', (e) => {
      const target = e.target.closest && e.target.closest('[data-track]');
      if (!target) return;
      const event = target.dataset.track;
      const props = {};
      for (const [k, v] of Object.entries(target.dataset)) {
        if (k.startsWith('trackProp')) {
          const propName = k.replace('trackProp', '').toLowerCase();
          props[propName] = v;
        }
      }
      if (window.gtag) window.gtag('event', event, props);
      if (window.dataLayer) window.dataLayer.push({ event, ...props });
    }, { passive: true });
  })();
</script>

<!-- Web Vitals RUM — analytics_storage=granted 동의 시에만 로드. ClientRouter 재실행 안전. -->
<script>
  import { initVitals } from '../lib/vitals';

  type GuardedWindow = Window & { __vitalsBootstrap?: boolean };
  const w = window as GuardedWindow;

  function maybeInit() {
    let granted = false;
    try {
      granted = localStorage.getItem('consent') === 'granted';
    } catch {}
    if (granted) initVitals();
  }

  maybeInit();

  if (!w.__vitalsBootstrap) {
    w.__vitalsBootstrap = true;
    window.addEventListener('consent:granted', maybeInit, { once: false });
  }
</script>

<!--
  Sentry 에러 추적 — DSN 설정 시에만 lazy 로드. initSentry 내부 가드로 멱등.
-->
<script>
  import { initSentry } from '../lib/error-tracking';

  type IdleWindow = Window & {
    __sentryBootstrap?: boolean;
    requestIdleCallback?: (cb: () => void, opts?: { timeout: number }) => number;
  };
  const w = window as IdleWindow;
  if (!w.__sentryBootstrap) {
    w.__sentryBootstrap = true;
    const start = () => initSentry().catch(() => {});
    if (typeof w.requestIdleCallback === 'function') {
      w.requestIdleCallback(start, { timeout: 3000 });
    } else {
      setTimeout(start, 1500);
    }
  }
</script>
