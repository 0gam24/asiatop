---
import { findCluster, clusterAccentDark } from '../data/clusters';
import { href as normalizeHref } from '../lib/url';
interface Props {
  href: string;
  title: string;
  description: string;
  cluster: string;
  publishedAt: Date;
  size?: 'sm' | 'md' | 'lg';
}
const { href, title, description, cluster, publishedAt, size = 'md' } = Astro.props;
const c = findCluster(cluster);
const dateStr = new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' }).format(publishedAt);
---
<a class={`article-card size-${size}`} href={normalizeHref(href)}>
  <div class="meta">
    {c && <span class="tag" style={`--accent-light: ${c.accent}; --accent-dark: ${clusterAccentDark(c.accent)};`}>{c.shortTitle}</span>}
    <time class="date" datetime={publishedAt.toISOString()}>{dateStr}</time>
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
</a>

<style>
.article-card {
  display: flex;
  flex-direction: column;
  gap: 0.45rem;
  padding: 1rem;
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-card);
  transition: border-color 150ms, box-shadow 150ms;
}
.article-card:hover {
  border-color: var(--color-primary);
  box-shadow: 0 4px 12px rgba(0, 200, 150, 0.08);
}
.meta {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  font-size: 0.72rem;
}
.tag {
  --accent: var(--accent-light);
  display: inline-flex;
  align-items: center;
  height: 22px;
  padding-inline: 0.5rem;
  border: 1px solid color-mix(in oklab, var(--accent) 35%, transparent);
  color: var(--accent);
  border-radius: 999px;
  font-weight: 600;
}
[data-theme="dark"] .tag { --accent: var(--accent-dark); }
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) .tag { --accent: var(--accent-dark); }
}
.date { color: var(--color-muted); }
.article-card h3 {
  font-size: 0.98rem;
  font-weight: 700;
  color: var(--color-secondary);
  letter-spacing: -0.025em;
  line-height: 1.4;
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.article-card p {
  font-size: 0.85rem;
  line-height: 1.55;
  color: var(--color-muted);
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.size-lg h3 { font-size: 1.15rem; -webkit-line-clamp: 3; }
.size-lg p { -webkit-line-clamp: 3; }
</style>
