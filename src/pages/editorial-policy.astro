---
import Base from '../layouts/Base.astro';

const url = new URL('/editorial-policy/', Astro.site).toString();
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '홈', item: Astro.site?.toString() },
    { '@type': 'ListItem', position: 2, name: '편집 정책', item: url },
  ],
};

// R67-4 — DigitalDocument schema. NewsMediaOrganization.publishingPrinciples 가
// 이미 본 URL 을 가리킴 → 본 페이지 자체에 DigitalDocument 마크업 → Google KG +
// E-E-A-T fact-checking publisher 인증 신호 강화.
const policyDocSchema = {
  '@context': 'https://schema.org',
  '@type': 'DigitalDocument',
  '@id': `${url}#policy-doc`,
  name: '머니룩 편집 정책',
  url,
  publisher: { '@id': new URL('#organization', Astro.site).toString() },
  about: '사실 확인·정정·AI 사용·1차 자료 검증',
  inLanguage: 'ko-KR',
  dateModified: '2026-04-29',
  isAccessibleForFree: true,
  hasPart: [
    { '@type': 'WebPageElement', name: '사실 확인 절차', url: `${url}#verification` },
    { '@type': 'WebPageElement', name: '정정 정책', url: `${url}#corrections` },
    { '@type': 'WebPageElement', name: '소유·자금 정보', url: `${url}#ownership` },
    { '@type': 'WebPageElement', name: '윤리 정책', url: `${url}#ethics` },
    { '@type': 'WebPageElement', name: '익명 출처 정책', url: `${url}#sources` },
  ],
};
---
<Base
  title="편집 정책 — 사실 확인·정정·AI 사용 정책"
  description="머니룩의 콘텐츠 제작·1차 자료 검증·전문가 검수·정정·AI 사용 정책. YMYL(금융·세무·법률·복지) 분야의 신뢰성을 위한 강제 절차와 24시간 정정 약속을 명시합니다."
  jsonLd={[breadcrumbSchema, policyDocSchema]}
>
  <article class="container narrow prose">
    <header>
      <p class="kicker">Editorial</p>
      <h1>편집 정책</h1>
      <p class="meta">최종 갱신: 2026년 4월 29일 · 검토 주기: 6개월</p>
    </header>

    <h2>사실 확인 절차</h2>
    <p>모든 글은 발행 전 <strong>8단계 자동 검증 게이트(G0~G8)</strong>를 거칩니다:</p>
    <ol>
      <li><strong>1차 자료 직접 확인</strong> — 공공데이터포털(data.go.kr)·법제처(law.go.kr)·홈택스·복지로·한국은행 ECOS·금융감독원 공시 등 공식 출처를 우선 인용합니다. 모든 출처 URL을 본문에 명시해 누구나 검증할 수 있도록 합니다.</li>
      <li><strong>통계·수치 검증</strong> — 모든 통계는 발행 시점·단위·출처 URL을 명시합니다. 출처 없는 수치는 사용하지 않습니다.</li>
      <li><strong>법령·정책 시점 표기</strong> — 본문 상단에 "데이터 기준 YYYY년 M월" 형식으로 시점을 명시합니다. 발행 후 180일 경과 시 자동으로 갱신 알림 배너를 노출합니다.</li>
      <li><strong>권위 데이터 1:1 매칭 (G4)</strong> — 본문에 등장하는 수치·날짜·법령 토큰을 정부 공식 API 응답과 1:1로 매칭합니다. <strong>매칭률 70% 이상만 발행</strong>되며, 미매칭 토큰은 본문에 인라인 출처 명시(예: "국세청 2025")가 요구됩니다. (정부 API 응답이 모든 사실을 보유하지 않을 수 있어 100% 매칭은 기술적으로 불가하며, 70% 임계로 신뢰성과 발행 가능성을 양립합니다.)</li>
      <li><strong>AdSense 정책·표절·AI 자연체 게이트 (G5~G8)</strong> — 추천성·강요성 표현·지식인 원문 인용·AI 정형화 패턴을 자동 검출하고 위반 시 발행을 차단합니다.</li>
    </ol>

    <p class="disclaimer-box">
      <strong>중요 — 자격 보유 전문가의 직접 검수는 받지 않습니다.</strong> 머니룩 편집팀은 자격 보유 세무사·노무사·재무설계사가 아니며, 따라서 본 글은 일반 정보 제공이지 세무·법률·재무 자문이 아닙니다. 정확한 신청 자격·요율은 신청 직전 해당 기관(국세청·복지부·고용노동부·금감원 등)의 공식 안내에서 재확인하시기 바랍니다.
    </p>

    <h2>정정 정책</h2>
    <ul>
      <li>사실 오류 발견 시 <strong>24시간 이내 정정</strong>합니다.</li>
      <li>중대한 오류는 글 하단에 <strong>"정정 이력"</strong>을 표기하고 갱신일을 갱신합니다.</li>
      <li>경미한 오타·표현은 별도 표기 없이 즉시 수정합니다.</li>
      <li>정정 요청은 <a href="/contact">문의 페이지</a> 또는 이메일로 받습니다.</li>
    </ul>

    <h2>AI 도구 사용 정책</h2>
    <p>
      머니룩은 AI(DeepSeek·Claude)를 <strong>초안 작성·문장 다듬기 도구</strong>로 사용합니다. 발행 단계에서는 <strong>8단계 자동 검증 게이트(G0~G8)와 정부 공식 API의 권위 데이터 1:1 매칭(임계 70%)</strong>이 사실 확인을 수행하며, 매칭률 70% 미만 또는 게이트 위반 시 자동으로 발행이 거부됩니다. 미매칭 토큰에 대해서는 본문에 출처를 인라인으로 명시합니다. 모든 글 본문 끝에 AI 보조 사용 공시(ai_assistance_disclosure)를 부착합니다.
    </p>

    <h3>8단계 자동 검증 게이트</h3>
    <ul>
      <li><strong>G0~G3 (Pre-LLM)</strong> — 24h 중복 차단·PII/욕설/정치 차단·12 cluster 매핑·권위 소스 가용성</li>
      <li><strong>G4 fact-verifier</strong> — 본문 사실 토큰(수치·날짜·법령) ↔ 정부 공식 API 응답 1:1 매칭 (매칭률 70% 이상만 발행, 미매칭 토큰은 인라인 출처 명시)</li>
      <li><strong>G5 AdSense 정책</strong> — 추천성·강요성·수익률 보장 표현 자동 차단</li>
      <li><strong>G6 면책·공시</strong> — YMYL 면책 + AI 보조 공시 자동 부착</li>
      <li><strong>G7 표절·저작권</strong> — 외부 원문 8단어+ 인용 자동 차단</li>
      <li><strong>G8 AI-likeness</strong> — AI 정형화 패턴(15 시그널) 자동 검출</li>
    </ul>

    <h3>금지 사항</h3>
    <ul>
      <li><strong>권위 데이터에 매칭되지 않는 수치·법령은 본문에 등장할 수 없습니다.</strong> G4 게이트가 자동 거부합니다.</li>
      <li>저자란에 가짜 인물(AI 페르소나)을 쓰지 않습니다. 모든 글은 <strong>"머니룩 편집팀"</strong> 단일 표기입니다.</li>
      <li>출처 없는 통계·수치는 본문에 사용하지 않습니다.</li>
      <li>"추천", "최고의", "1위" 같은 표현은 [제휴]/[광고] 명시가 있을 때만 사용합니다.</li>
    </ul>

    <h2>광고·제휴·이해 충돌</h2>
    <ul>
      <li>광고는 Google AdSense를 통해 자동 게재되며, 본문과 시각적으로 명확히 구분됩니다.</li>
      <li>제휴 콘텐츠는 본문 상단에 <strong>"[제휴]" 또는 "[스폰서]"</strong>를 명시합니다.</li>
      <li>광고주·제휴사로부터 편집 방향에 영향을 받지 않습니다.</li>
      <li>이해 충돌이 있는 주제는 본문에 명시하거나 해당 주제 작성을 회피합니다.</li>
    </ul>

    <h2>저자 정책</h2>
    <ul>
      <li>모든 글의 저자는 <strong>"머니룩 편집팀"</strong>(스마트데이터샵 운영진)으로 표기됩니다.</li>
      <li>가상 인물·AI 페르소나로 자격 보유자를 사칭하지 않습니다.</li>
      <li>외부 자격 보유 전문가(세무사·노무사·CFP 등)의 글이 게재될 경우 그분의 실명·자격증 등록 사실·연락처를 함께 명시합니다.</li>
      <li>제휴·후원 콘텐츠는 본문 상단에 명시 라벨을 부착합니다.</li>
    </ul>

    <h2>윤리 강령</h2>
    <ul>
      <li>표절 금지 — 출처 없는 인용·복제 금지</li>
      <li>사실 왜곡 금지 — 통계·인용은 원문 맥락 보존</li>
      <li>차별·혐오 표현 금지</li>
      <li>독자 사생활·정보 출처 보호</li>
    </ul>

    <h2>검토 주기</h2>
    <ul>
      <li>모든 글은 <strong>6개월마다</strong> 재검토합니다 (YMYL 강화).</li>
      <li>법령·정책 변경 발표 시 즉시 영향받는 글을 갱신합니다.</li>
      <li>본 편집 정책 자체도 6개월마다 갱신·공지합니다.</li>
    </ul>

    <h2>문의</h2>
    <p>편집 정책·정정 요청·제보는 <a href="/contact">문의 페이지</a>에서 받습니다.</p>
  </article>
</Base>

<style>
.container { max-width: 760px; padding-inline: 1rem; margin-inline: auto; }
.narrow { padding-block: 2.5rem 4rem; }
.kicker {
  display: inline-flex;
  height: 26px;
  padding-inline: 0.6rem;
  background: var(--color-mint-bg);
  color: var(--color-primary-700);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  border-radius: 999px;
  text-transform: uppercase;
  margin: 0 0 1rem;
}
h1 {
  font-size: clamp(1.8rem, 5vw, 2.4rem);
  font-weight: 800;
  letter-spacing: -0.035em;
  color: var(--color-secondary);
  margin: 0 0 0.4rem;
}
.meta { color: var(--color-muted); font-size: 0.82rem; margin: 0 0 2rem; }
.disclaimer-box {
  background: color-mix(in oklab, var(--color-accent) 8%, var(--color-bg));
  border: 1px solid color-mix(in oklab, var(--color-accent) 35%, transparent);
  border-radius: var(--radius-card);
  padding: 1rem 1.25rem;
  font-size: 0.92rem;
  line-height: 1.7;
  color: var(--color-text);
  margin: 1.25rem 0 0;
}
.disclaimer-box strong { color: var(--color-secondary); }
</style>
