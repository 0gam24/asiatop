---
import Base from '../layouts/Base.astro';

const url = new URL('/corrections/', Astro.site).toString();

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '홈', item: Astro.site?.toString() },
    { '@type': 'ListItem', position: 2, name: '정정 이력', item: url },
  ],
};

// 정정 이력 — 사실 오류 발견 시 24시간 이내 정정, 본 페이지에 시간순 기록.
// 정정 발생 시 아래 corrections 배열에 항목 추가:
//   { date: 'YYYY-MM-DD', article: '/cluster/slug/', summary: '간단 설명', detail: '구체 변경' }
const corrections: Array<{
  date: string;
  article: string;
  articleTitle?: string;
  summary: string;
  detail: string;
}> = [];

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': url,
  name: '정정 이력 | 머니룩',
  description: '머니룩의 사실 오류 정정 이력. 24시간 이내 정정 정책에 따라 시간순으로 기록합니다.',
  url,
  inLanguage: 'ko-KR',
  isPartOf: { '@id': new URL('/editorial-policy/#corrections', Astro.site).toString() },
  publisher: { '@id': new URL('#organization', Astro.site).toString() },
};
---
<Base
  title="정정 이력 — 24시간 정정 정책 | 머니룩"
  description="머니룩의 사실 오류 정정 이력. 24시간 이내 정정 정책에 따라 시간순으로 모든 정정 사항을 기록합니다."
  jsonLd={[breadcrumbSchema, collectionSchema]}
>
  <article class="container narrow">
    <header>
      <p class="kicker">Corrections</p>
      <h1>정정 이력</h1>
      <p class="lede">
        머니룩은 사실 오류 발견 시 <strong>24시간 이내 정정</strong>합니다. 모든 정정은 본 페이지에
        시간순으로 기록하며, 해당 글 하단에도 정정 이력을 표기합니다.
      </p>
    </header>

    <section class="policy">
      <h2>정정 정책 요약</h2>
      <ul>
        <li><strong>중대한 오류</strong> (수치·자격·법령 시점) — 24시간 이내 본문 정정 + 본 페이지 기록 + 글 하단 "정정 이력" 명시 + <code>dateModified</code> 갱신</li>
        <li><strong>경미한 표현·오타</strong> — 별도 기록 없이 즉시 수정</li>
        <li><strong>정책 변경에 따른 갱신</strong> — 별도 정정이 아닌 글 본문 업데이트로 처리 (정정 이력에 포함 X)</li>
        <li><strong>정정 요청 채널</strong> — <a href="/contact">문의 페이지</a> 또는 <a href="mailto:smartdatashop@gmail.com">smartdatashop@gmail.com</a></li>
      </ul>
      <p class="ref">
        세부 절차: <a href="/editorial-policy/#corrections">편집 정책 → 정정 정책</a>
      </p>
    </section>

    <section class="log">
      <h2>정정 이력 (시간순)</h2>
      {corrections.length === 0 ? (
        <div class="empty">
          <p><strong>현재까지 정정 이력 없음.</strong></p>
          <p class="muted">
            본 사이트 운영 개시 이후 사실 오류로 인한 정정 사례가 발생하지 않았습니다. 발생 시 24시간 이내 본 페이지에 기록됩니다.
          </p>
        </div>
      ) : (
        <ol class="entries">
          {corrections.map((c) => (
            <li class="entry">
              <time datetime={c.date}>{c.date}</time>
              <div class="entry-body">
                <p class="article-link">
                  <a href={c.article}>{c.articleTitle ?? c.article}</a>
                </p>
                <p class="summary">{c.summary}</p>
                <p class="detail">{c.detail}</p>
              </div>
            </li>
          ))}
        </ol>
      )}
    </section>

    <section class="verification">
      <h2>검증과 정정의 분리</h2>
      <p>
        2026년 6월부터 모든 신규 글은 편집팀이 정부 1차 출처를 직접 확인해 작성·검수합니다.
        그 이전 자동 발행분은 발행 당시 10단계 자동 검증 게이트(G0~G9)가 본문 사실 토큰을
        정부 공식 API 응답과 1:1 매칭해 발행 시점의 사실 오류를 게이트 단에서 차단했습니다.
      </p>
      <p>
        본 페이지의 정정 이력은 다음 4가지 경우를 대상으로 합니다:
      </p>
      <ol>
        <li>발행 후 <strong>정책·법령·요율 변경</strong> 으로 기존 본문이 사실과 어긋난 경우 (자동 갱신 + 정정 기록)</li>
        <li>발행 시점 <strong>1차 자료 자체의 오류</strong> 가 사후에 정정된 경우 (출처 측 정정 반영)</li>
        <li><strong>독자 제보</strong> 또는 검증 게이트가 놓친 표현 오류</li>
        <li>발행 시점 <strong>해석 오류</strong> 가 발견된 경우 (수치는 맞으나 의미·적용 범위 해석이 어긋남)</li>
      </ol>
    </section>
  </article>
</Base>

<style>
  .container { max-width: 760px; padding-inline: 1rem; margin-inline: auto; padding-block: 2.5rem 4rem; }
  .narrow { }
  .kicker {
    display: inline-flex; height: 26px; padding-inline: 0.6rem;
    background: var(--color-mint-bg); color: var(--color-primary-700);
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em;
    border-radius: 999px; text-transform: uppercase; margin: 0 0 1rem;
  }
  h1 { font-size: clamp(1.8rem, 5vw, 2.4rem); font-weight: 800; letter-spacing: -0.035em; color: var(--color-secondary); margin: 0 0 0.85rem; }
  h2 { font-size: 1.2rem; font-weight: 800; color: var(--color-secondary); margin: 2.5rem 0 0.85rem; letter-spacing: -0.025em; }
  .lede { font-size: 1.06rem; color: var(--color-muted); line-height: 1.7; margin: 0 0 2rem; }

  .policy ul { padding-left: 1.2rem; line-height: 1.75; color: var(--color-text); }
  .policy li { margin-bottom: 0.5rem; }
  .policy code { background: var(--color-surface); padding: 0.1em 0.35em; border-radius: 4px; font-size: 0.9em; }
  .ref { font-size: 0.88rem; color: var(--color-muted); margin-top: 1rem; }
  .ref a { color: var(--color-primary-700); text-decoration: underline; text-underline-offset: 3px; }

  .empty {
    background: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-card);
    padding: 1.5rem;
    text-align: center;
  }
  .empty p { margin: 0 0 0.4rem; }
  .empty .muted { color: var(--color-muted); font-size: 0.9rem; }

  .entries { list-style: none; padding: 0; margin: 0; }
  .entry { display: flex; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--color-border); }
  .entry time { font-variant-numeric: tabular-nums; color: var(--color-muted); font-size: 0.88rem; min-width: 6.5rem; flex-shrink: 0; }
  .entry-body { flex: 1; }
  .article-link a { font-weight: 700; color: var(--color-primary-700); }
  .summary { margin: 0.25rem 0; font-weight: 600; }
  .detail { color: var(--color-muted); font-size: 0.92rem; line-height: 1.6; margin: 0.25rem 0 0; }

  .verification ol { padding-left: 1.2rem; line-height: 1.75; color: var(--color-text); }
  .verification li { margin-bottom: 0.4rem; }
  .verification p { color: var(--color-text); line-height: 1.7; margin: 0 0 0.85rem; }
</style>
