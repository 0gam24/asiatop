---
import Base from '../layouts/Base.astro';

const url = new URL('/corrections/', Astro.site).toString();

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '홈', item: Astro.site?.toString() },
    { '@type': 'ListItem', position: 2, name: '정정 이력', item: url },
  ],
};

// 정정 이력 — 사실 오류 발견 시 24시간 이내 정정, 본 페이지에 시간순 기록.
// 정정 발생 시 아래 corrections 배열에 항목 추가:
//   { date: 'YYYY-MM-DD', article: '/cluster/slug/', summary: '간단 설명', detail: '구체 변경' }
const corrections: Array<{
  date: string;
  article: string;
  articleTitle?: string;
  summary: string;
  detail: string;
}> = [
  {
    date: '2026-10-14',
    article: '/unemployment/unemployment-benefit-application/',
    articleTitle: '실업급여 매일 6.6만원 — 이직 후 7일 안에 해야 할 일',
    summary: '이직확인서 발급 기한·미발급 시 신청 가능 여부, 신청 기한, 180일 요건, 구직급여 하한 설명, 부정수급 제재 등 오류 정정',
    detail: '이직확인서를 회사가 이직일로부터 10일 이내 고용센터에 내야 한다(근거 고용보험법 제15조)던 서술을 근로자의 발급요청서를 받은 날부터 10일 이내 발급(법 제42조제3항, 시행규칙 제82조의2제2항)으로, 이직확인서가 없으면 신청할 수 없다던 서술을 그 기한 안에 받지 못하면 내지 않고 신청할 수 있다(같은 조 제3항)로 바로잡음. 이직 후 12개월을 신청 기한으로 적은 부분을 지체 없는 실업 신고(법 제42조제1항)와 이직일 다음 날부터 12개월인 수급기간(제48조)으로, 180일 요건을 보수 지급의 기초가 된 날을 합한 피보험 단위기간(제40조·제41조)으로, 하한 최저시급 80%를 하루 소정근로시간에 최저임금을 곱한 금액의 80%(제45조제4항·제46조)로 고침. 추가징수 1~5배, 5년간 실업급여 수급 제한, 사기죄를 2배 이하·사업주 공모 시 5배 이하(제62조제2항), 10년간 3회 이상 지급 제한 때 1~3년 제한(제61조제5항, 시행령 제80조의2), 제116조 벌칙으로 바로잡고, 워크넷을 고용24로, 방문·온라인 택일로 적은 실업 신고를 출석 원칙(제42조제1항)으로 고침. 구직활동 3회 미흡 시 수급자격 박탈 서술과 근거를 확인하지 못한 교육 시간(약 60분)·인정 기간(1~2주)·회차별 구직활동 2건·사이버 실업인정 확대·정당한 이직 사유 표의 세부 기준·이직확인서 정정 청구 절차는 삭제.',
  },
  {
    date: '2026-10-14',
    article: '/insurance-labor/four-insurance-regular-vs-freelance-cost/',
    articleTitle: '4대보험료 부담 비교: 정규직 vs 프리랜서, 누가 더 절감할까?',
    summary: '2026년 4대보험 요율, 프리랜서 고용보험 적용, 보험료의 세금 처리 등 오류 정정',
    detail: '2026년 요율 국민연금 9%(본인 4.5%)·건강보험 7.09%(본인 3.545%)를 9.5%(본인 4.75%)·7.19%(본인 3.595%)로 고치고, 장기요양보험료가 건강보험료에 포함된 것처럼 적은 부분을 별도 보험료(0.9448%)로 바로잡음. 프리랜서 건강보험료를 소득 × 7.09%로 계산한 부분을 지역가입자 산정 방식(소득월액 × 7.19% + 재산 몫, 국민건강보험법 제69조제5항)으로, 프리랜서 고용보험을 일률적인 임의가입·1.8%로 적은 부분을 예술인·노무제공자 적용(고용보험법 제77조의2·제77조의6, 1.6%)과 요건을 갖춘 자영업자 임의가입(징수법 제49조의2, 2.25%)으로 고침. 국민연금 임의계속가입을 보험료 조정 수단으로, 건강보험료 등급 조정 신청을 절감 방법으로 적은 부분은 국민연금 납부 예외(국민연금법 제91조)·저소득 지역가입자 보험료 지원(제100조의4)·건강보험 소득월액 조정과 정산(국민건강보험법 시행령 제41조의2)으로 바꾸고, 고용보험 가입 6개월 뒤 실업급여 수급 서술은 삭제함. 프리랜서 건강보험료를 소득공제 대상으로, 고용·산재보험료를 공제 대상이 아니라고 적은 서술은 소득세법 제51조의3·제52조와 같은 법 시행령 제55조제1항제11호의3~제11호의5(지역가입자 건강·장기요양보험료, 예술인·노무제공자·자영업자 고용보험료, 산재보험이 적용되는 노무제공자·중소기업 사업주 산재보험료는 사업소득 필요경비) 기준으로 바로잡음. 피부양자 요건을 소득 연 2,000만원 기준만 적은 부분은 시행규칙 별표 1의2(사업자등록이 없으면 사업소득 연 500만원 이하 등) 기준으로 고치고, 근거를 확인할 수 없는 실수령액·연간 차액은 삭제.',
  },
  {
    date: '2026-10-14',
    article: '/insurance-labor/workplace-vs-regional-insurance-cost/',
    articleTitle: '취업자 직장가입 vs 지역가입, 국민연금 보험료 차이 완벽 정리',
    summary: '국민연금 2026년 보험료율 9.5%, 기준소득월액 상한·하한, 납부기한, 연체금 등 오류 정정',
    detail: '2026년 보험료율 9%(직장 본인 4.5%)를 2025년 4월 개정 국민연금법 부칙 제4조의 9.5%(본인 4.75%)로, 소득 하한 월 110만원·최저 보험료 월 9만 9,000원·최고 보험료 월 48만 6,000원을 국민연금공단 안내의 41만~659만원(2026년 7월~2027년 6월) 기준으로, 납부기한 매월 25일을 다음 달 10일(제89조제1항)로 바로잡음. 퇴사 후 1개월 이내 재취업하면 직장가입자 자격이 유지된다는 서술, 회사 부담분만큼 연금이 더 쌓인다는 서술, 겸업 시 주된 소득 쪽으로 가입 자격이 정해진다는 서술, 체납 6개월이면 수급 자격이 위험하다는 서술, 연체료 연 9%, 추후납부를 체납 기간에 쓰는 제도로 설명한 부분, 근거를 확인하지 못한 최대 12개월 분할 납부 서술, 건강보험료율 7.09%와 자동차가 반영된다는 서술을 국민연금법 제9조·제12조·제51조·제92조·제97조와 국민건강보험법 제69조·시행령 제44조 기준으로 고치거나 삭제하고, 납부 예외(시행령 제61조), 기준소득월액 변경(시행령 제7조), 체납보험료 분할납부(제95조의3), 저소득 지역가입자 보험료 지원(제100조의4)을 더함.',
  },
  {
    date: '2026-10-14',
    article: '/insurance-labor/four-insurance-rate-2026-summary/',
    articleTitle: '2026년 4대보험 요율 총정리 — 국민연금·건강·고용·산재 (근로자 부담)',
    summary: '2026년 장기요양보험료 비율과 고용보험 실업급여 전체 요율 정정',
    detail: '2026년 장기요양보험료를 건강보험료의 약 12.95%로 적었던 것을 장기요양보험료율 0.9448%(노인장기요양보험법 시행령 제4조, 2026년 1월 1일 시행) 기준 약 13.14%로, 고용보험 실업급여 전체 요율 0.9%를 1.8%(보험료징수법 시행령 제12조제1항제2호, 근로자·사업주 각 0.9%)로 바로잡음. 근거를 확인하지 못한 산재보험 평균 요율 약 1.4%·업종별 위험도 서술·두루누리 지원 비율(80%)과 근로자 1인 이상 사업장 의무 가입 서술은 삭제하거나 조문 기준(보험료징수법 제14조, 산업재해보상보험법 제6조)으로 고치고, 국민연금 인상 일정(2033년 13%)과 기준소득월액 상한·하한을 조문·공단 안내 기준으로 구체화함.',
  },
  {
    date: '2026-10-14',
    article: '/insurance-labor/nhis-voluntary-continued-after-retirement/',
    articleTitle: '퇴직 후 건강보험료 폭탄 막는 법: 임의계속가입제도 완벽 가이드',
    summary: '임의계속가입 신청 기한·자격·보험료 산정, 피부양자와의 관계, 재취업 뒤 재신청 등 오류 정정',
    detail: '신청 기한 "퇴직일로부터 14일 이내, 2개월까지 소급"을 법 제110조제1항(첫 지역가입자 보험료 고지 후 그 납부기한에서 2개월이 지나기 전까지)으로, 자격 "직장가입자로 1일 이상 가입"을 퇴사 전 18개월 중 통산 1년 이상(시행규칙 제62조)으로, 보험료 "퇴직 전 직장에서 부담하던 보험료(근로자 부담분)와 동일한 금액"을 최근 12개월 보수월액 평균 기준·본인 전액 부담·고시에 따른 경감 가능(법 제110조제3항~제5항)으로, 근거 "시행령 제48조"를 법 제110조·시행령 제77조로 바로잡음. 법과 공단 안내에 없는 "피부양자로 등록 가능하면 신청 불가"를 지우고, "재취업하면 재신청 불가"는 공단 안내(다시 요건을 채우면 재신청 가능)에 맞게 고침. 보험료율 7.09%를 7.19%로, 장기요양보험료 약 12.27%를 2026년 비율(약 13.14%)로 고치고, 설명문의 직장보험료 동결을 퇴직 전 직장에서 부담하던 수준의 보험료로 고침. 지역가입자 재산의 자동차 서술과 근거를 확인하지 못한 보험료 비교표·사례·지사 수·인용문은 삭제.',
  },
  {
    date: '2026-10-14',
    article: '/insurance-labor/workplace-vs-regional-insured/',
    articleTitle: '직장가입자 vs 지역가입자, 퇴직 후 건보료 폭탄 막는 법',
    summary: '보험료율 7.09%, 자동차 점수, 임의계속가입 근거·신청 기한, 피부양자 요건 등 오류 정정',
    detail: '보험료율 7.09%(본인 3.545%)를 시행령 제44조 기준 7.19%(본인 3.595%)로, 지역가입자 보험료 "소득·재산·자동차 점수"를 법 제69조제5항의 소득과 재산(재산보험료부과점수당 211.5원, 시행령 제44조제2항)으로, 임의계속가입 근거 "법 제79조"와 신청 기한 "퇴직일로부터 2개월 이내"를 법 제110조제1항(첫 지역가입자 보험료 고지 후 그 납부기한에서 2개월이 지나기 전까지)으로 바로잡음. 피부양자 요건의 "만 60세 이상 부모"와 "공시가 9억"을 시행규칙 별표 1(부양요건)과 별표 1의2(재산세 과세표준 5억4천만원·9억원)로 고치고, 피부양자 신고 90일 소급(시행규칙 제2조제2항)과 재취업 시 자격 변동(법 제9조, 시행규칙 제63조)을 조문 기준으로 다시 씀. 설명문과 본문의 인상 배수(2~5배)와 근거를 확인하지 못한 보험료 사례·자동차 점수 표·심사 기간 서술은 삭제.',
  },
  {
    date: '2026-10-14',
    article: '/insurance-labor/health-insurance-premium-spike-adjustment/',
    articleTitle: '건강보험료 갑작스러운 인상, 이유와 조정 신청법 총정리',
    summary: '보험료율 7.09%, 자동차 반영, 피부양자 상실 시 본인 보험료 인상 등 오류 정정',
    detail: '보험료율을 시행령 제44조 기준 7.19%로, 지역가입자 보험료를 소득과 재산(재산보험료부과점수당 211.5원)으로 바로잡음. 피부양자 상실은 직장가입자 본인 보험료를 바꾸지 않고(법 제69조제4항) 소득·재산 요건을 넘어 빠진 가족이 가입자 자격을 얻어 보험료를 내게 되는 것(법 제8조제1항제2호, 시행규칙 별표 1의2)으로 고침. 연봉 20% 인상 때 보험료 약 10% 상승이라던 계산을 보수월액에 비례하는 계산 예시로 바꾸고, 직장가입자 매년 4월 보수월액 적용과 전년도 보험료 정산(시행령 제34조·제35조·제39조), 소득월액 조정과 정산(시행령 제41조의2)을 조문 기준으로 다시 씀. 근거를 확인하지 못한 처리기간(7~14일)·적용 시기·절감액·실업급여 서술은 삭제.',
  },
  {
    date: '2026-10-14',
    article: '/insurance-labor/health-insurance-reduction/',
    articleTitle: '건강보험료 줄이는 합법적인 방법 7가지 — 직장인·지역가입자 모두',
    summary: '지역가입자 자동차 점수, 보험료율, 임의계속가입 신청 기한, 피부양자 요건 등 오류 정정',
    detail: '보험료율 3.545%(본인 몫)와 지역가입자 보험료를 소득·재산·자동차에 점수를 매겨 점수당 약 220원을 곱한다는 서술을 7.19%와 소득월액·재산보험료부과점수(211.5원) 기준으로, 임의계속가입 신청 기한 "퇴직일로부터 2개월 이내"를 법 제110조제1항 기준으로, 피부양자 사업소득 "0원"과 나이만 적은 형제자매 요건을 시행규칙 별표 1·별표 1의2 기준으로, 소득 기준이 강화된 시점 2022년 7월을 9월로 바로잡음. 현행 법 제69조제5항·시행령 제42조제1항에 없는 자동차 점수 서술, 장기요양보험료 12.95% 서술, 근거를 확인하지 못한 탈락 인원·보험료 금액·감면 기준은 삭제하고, 설명문의 자동차 처분을 피부양자 등록으로 고침. 제목의 7가지 방법은 보험료 경감 대상(법 제75조제1항)과 전자고지·자동이체 감액(같은 조 제2항)을 더해 조문 기준으로 다시 씀.',
  },
  {
    date: '2026-10-14',
    article: '/unemployment/post-resignation-insurance/',
    articleTitle: '퇴직 후 4대보험 처리 — 건강·국민·고용보험 어떻게 바뀌나',
    summary: '건강보험 임의계속가입 신청 기한, 피부양자 기준, 국민연금 지역가입자 보험료율 9.5% 등 정정',
    detail: '임의계속가입 신청 기한 "퇴직 후 2개월 이내"와 일정표의 "퇴직일 + 2주: 건강보험 임의계속가입 신청"을 국민건강보험법 제110조제1항(첫 지역가입자 보험료 고지 후 그 납부기한에서 2개월이 지나기 전까지) 기준으로, 피부양자 사업소득 "0원"과 재산 "과세표준 5.4억원 이하"를 시행규칙 별표 1의2 기준으로 바로잡음. 국민연금은 퇴사하면 "자동 정지"된다던 서술을 60세 미만은 지역가입자가 되고 실직 시 납부 예외를 신청할 수 있다는 국민연금법 제9조·제91조와 시행령 제61조 기준으로, 지역가입자 보험료 "소득의 9%"를 2025년 4월 개정 부칙 제4조제2항의 2026년 9.5%로, 설명문의 국민연금 임의가입을 납부 예외로 바로잡음. 근거를 확인하지 못한 보험료 금액(월 50만원 이상), 국민연금 수령액 증가율, 실업급여 첫 수령 시점 서술은 삭제하고, 실업 신고 절차를 고용보험법 제42조·제44조·제48조·제49조·제54조 기준으로 다시 씀.',
  },
  {
    date: '2026-10-14',
    article: '/insurance-labor/nhis-family-cohabit-vs-non-cohabit/',
    articleTitle: '국민건강보험 가족 등록 완벽 가이드: 동거가족·비동거가족 차이와 피부양자 조건',
    summary: '피부양자 소득·재산 기준을 동거·비동거로 나눠 적은 오류 정정',
    detail: '비동거가족 소득 연 1,000만원·재산 3억원, 동거가족 재산 3.4억원, 형제자매 동거 한정, 금융소득 1,000만원 초과 제한 서술을 국민건강보험법 시행규칙 별표 1(부양요건)·별표 1의2(소득 및 재산요건) 기준으로 바로잡음. 소득·재산 기준은 동거 여부와 무관하고(소득 합계 연 2,000만원 이하, 재산세 과세표준 5억4천만원 이하 등) 동거 여부는 부양요건에서만 갈린다. 신고 서류·처리기간·자격 상실·벌칙 조항도 법령 기준으로 정정. 피부양자 비율 "약 38%"는 국민건강보험공단 적용인구 현황 기준 2025년 약 29.9%로 고치고, 법령에 없는 "주민등록표상 세대가 같으면 동거(시행령 제41조)" 서술은 삭제.',
  },
  {
    date: '2026-10-14',
    article: '/insurance-labor/health-insurance-workplace-to-regional-transition/',
    articleTitle: '퇴사 후 건강보험 지역가입자 전환, 언제부터 어떻게? 자격 변동 시점 완벽 정리',
    summary: '퇴사 후 지역가입자 자격 변동 시점과 보험료 기준 오류 정정',
    detail: '"지역가입자 자격은 신청일에 취득", "공백 기간 진료비 전액 본인 부담", "첫 달 일할 계산", "피부양자 재산 3.4억원 이하", "소득·재산·자동차 점수 합산" 서술을 국민건강보험법 제9조·제11조·제69조·제110조와 시행규칙 별표 1의2 기준으로 바로잡음. 근거를 확인하지 못한 사례 점수, "최저 보험료 약 19,780원", 실업급여 경감 서술은 삭제. 임의계속가입 조건에 "퇴사 전 18개월 동안"(시행규칙 제62조)을 보탬.',
  },
  {
    date: '2026-10-11',
    article: '/credit-loan/sunshine-loan-youth-2026/',
    articleTitle: '햇살론유스 — 청년 전용 정책대출 최대 1,200만원 (2026)',
    summary: '햇살론유스 한도를 "평생 1회만 이용"으로 적은 오류 정정',
    detail: '서민금융진흥원 상품 안내 기준으로 "1인당 생애 1,200만원 한도를 한 번 부여하고 그 안에서 나눠 이용할 수 있으며, 갚아도 한도가 되살아나지 않는다"로 바로잡고 1회·연간 한도를 추가.',
  },
  {
    date: '2026-10-10',
    article: '/tax/credit-card-deduction-calculation/',
    articleTitle: '신용카드 공제 계산법, 25% 초과부터 진짜 공제 시작',
    summary: '대중교통 공제율 80% 표기 정정',
    detail: '조세특례제한법 제126조의2(시행 2026. 9. 18.) 기준 대중교통 사용분 공제율 40%로 본문 수치(공제율·공제한도)를 정정하고(2026-10-10 반영), 설명문의 "대중교통 80% 한시 적용"도 40%로 맞춤(2026-10-11 반영).',
  },
];

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': url,
  name: '정정 이력 | 머니룩',
  description: '머니룩의 사실 오류 정정 이력. 24시간 이내 정정 정책에 따라 시간순으로 기록합니다.',
  url,
  inLanguage: 'ko-KR',
  isPartOf: { '@id': new URL('/editorial-policy/#corrections', Astro.site).toString() },
  publisher: { '@id': new URL('#organization', Astro.site).toString() },
};
---
<Base
  title="정정 이력 — 24시간 정정 정책 | 머니룩"
  description="머니룩의 사실 오류 정정 이력. 24시간 이내 정정 정책에 따라 시간순으로 모든 정정 사항을 기록합니다."
  jsonLd={[breadcrumbSchema, collectionSchema]}
>
  <article class="container narrow">
    <header>
      <p class="kicker">Corrections</p>
      <h1>정정 이력</h1>
      <p class="lede">
        머니룩은 사실 오류 발견 시 <strong>24시간 이내 정정</strong>합니다. 모든 정정은 본 페이지에
        시간순으로 기록하며, 해당 글 하단에도 정정 이력을 표기합니다.
      </p>
    </header>

    <section class="policy">
      <h2>정정 정책 요약</h2>
      <ul>
        <li><strong>중대한 오류</strong> (수치·자격·법령 시점) — 24시간 이내 본문 정정 + 본 페이지 기록 + 글 하단 "정정 이력" 명시 + <code>dateModified</code> 갱신</li>
        <li><strong>경미한 표현·오타</strong> — 별도 기록 없이 즉시 수정</li>
        <li><strong>정책 변경에 따른 갱신</strong> — 별도 정정이 아닌 글 본문 업데이트로 처리 (정정 이력에 포함 X)</li>
        <li><strong>정정 요청 채널</strong> — <a href="/contact/">문의 페이지</a> 또는 <a href="mailto:smartdatashop@gmail.com">smartdatashop@gmail.com</a></li>
      </ul>
      <p class="ref">
        세부 절차: <a href="/editorial-policy/#corrections">편집 정책 → 정정 정책</a>
      </p>
    </section>

    <section class="log">
      <h2>정정 이력 (시간순)</h2>
      {corrections.length === 0 ? (
        <div class="empty">
          <p><strong>현재까지 정정 이력 없음.</strong></p>
          <p class="muted">
            본 사이트 운영 개시 이후 사실 오류로 인한 정정 사례가 발생하지 않았습니다. 발생 시 24시간 이내 본 페이지에 기록됩니다.
          </p>
        </div>
      ) : (
        <ol class="entries">
          {corrections.map((c) => (
            <li class="entry">
              <time datetime={c.date}>{c.date}</time>
              <div class="entry-body">
                <p class="article-link">
                  <a href={c.article}>{c.articleTitle ?? c.article}</a>
                </p>
                <p class="summary">{c.summary}</p>
                <p class="detail">{c.detail}</p>
              </div>
            </li>
          ))}
        </ol>
      )}
    </section>

    <section class="verification">
      <h2>검증과 정정의 분리</h2>
      <p>
        2026년 6월부터 모든 신규 글은 편집팀이 정부 1차 출처를 직접 확인해 작성·검수합니다.
        그 이전 자동 발행분은 발행 당시 10단계 자동 검증 게이트(G0~G9)가 본문 사실 토큰을
        정부 공식 API 응답과 1:1 매칭해 발행 시점의 사실 오류를 게이트 단에서 차단했습니다.
      </p>
      <p>
        본 페이지의 정정 이력은 다음 4가지 경우를 대상으로 합니다:
      </p>
      <ol>
        <li>발행 후 <strong>정책·법령·요율 변경</strong> 으로 기존 본문이 사실과 어긋난 경우 (자동 갱신 + 정정 기록)</li>
        <li>발행 시점 <strong>1차 자료 자체의 오류</strong> 가 사후에 정정된 경우 (출처 측 정정 반영)</li>
        <li><strong>독자 제보</strong> 또는 검증 게이트가 놓친 표현 오류</li>
        <li>발행 시점 <strong>해석 오류</strong> 가 발견된 경우 (수치는 맞으나 의미·적용 범위 해석이 어긋남)</li>
      </ol>
    </section>
  </article>
</Base>

<style>
  .container { max-width: 760px; padding-inline: 1rem; margin-inline: auto; padding-block: 2.5rem 4rem; }
  .narrow { }
  .kicker {
    display: inline-flex; height: 26px; padding-inline: 0.6rem;
    background: var(--color-mint-bg); color: var(--color-primary-700);
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em;
    border-radius: 999px; text-transform: uppercase; margin: 0 0 1rem;
  }
  h1 { font-size: clamp(1.8rem, 5vw, 2.4rem); font-weight: 800; letter-spacing: -0.035em; color: var(--color-secondary); margin: 0 0 0.85rem; }
  h2 { font-size: 1.2rem; font-weight: 800; color: var(--color-secondary); margin: 2.5rem 0 0.85rem; letter-spacing: -0.025em; }
  .lede { font-size: 1.06rem; color: var(--color-muted); line-height: 1.7; margin: 0 0 2rem; }

  .policy ul { padding-left: 1.2rem; line-height: 1.75; color: var(--color-text); }
  .policy li { margin-bottom: 0.5rem; }
  .policy code { background: var(--color-surface); padding: 0.1em 0.35em; border-radius: 4px; font-size: 0.9em; }
  .ref { font-size: 0.88rem; color: var(--color-muted); margin-top: 1rem; }
  .ref a { color: var(--color-primary-700); text-decoration: underline; text-underline-offset: 3px; }

  .empty {
    background: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-card);
    padding: 1.5rem;
    text-align: center;
  }
  .empty p { margin: 0 0 0.4rem; }
  .empty .muted { color: var(--color-muted); font-size: 0.9rem; }

  .entries { list-style: none; padding: 0; margin: 0; }
  .entry { display: flex; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--color-border); }
  .entry time { font-variant-numeric: tabular-nums; color: var(--color-muted); font-size: 0.88rem; min-width: 6.5rem; flex-shrink: 0; }
  .entry-body { flex: 1; }
  .article-link a { font-weight: 700; color: var(--color-primary-700); }
  .summary { margin: 0.25rem 0; font-weight: 600; }
  .detail { color: var(--color-muted); font-size: 0.92rem; line-height: 1.6; margin: 0.25rem 0 0; }

  .verification ol { padding-left: 1.2rem; line-height: 1.75; color: var(--color-text); }
  .verification li { margin-bottom: 0.4rem; }
  .verification p { color: var(--color-text); line-height: 1.7; margin: 0 0 0.85rem; }
</style>
