---
import Base from '../../layouts/Base.astro';
import SalaryCalculator, { SALARY_DEFAULTS, calc } from '../../components/SalaryCalculator';
import withholdingTable from '../../data/income-tax-withholding-table.json';
import { withholdingIncomeTax } from '../../lib/income-tax-withholding';

const url = new URL('/calculators/salary/', Astro.site).toString();

// 근로소득 간이세액표는 빌드할 때만 여기서 읽는다(클라이언트는 계산 시점에 동적 import).
// 첫 화면 입력값의 근로소득세와 FAQ 예시 금액을 계산기와 같은 함수·같은 표로 계산해, 화면 출력과 글자가 항상 같게 한다.
const initialIncomeTax = withholdingIncomeTax(
  withholdingTable,
  SALARY_DEFAULTS.annualGross / 12,
  SALARY_DEFAULTS.family,
  SALARY_DEFAULTS.children,
);
const must = (n: number | null): number => {
  if (n === null) throw new Error('salary.astro: 예시 금액 계산 실패');
  return n;
};
/** 공제대상가족 1명(본인만), 8세 이상 20세 이하 자녀 0명, 비과세 0원 기준 계산기 출력 */
const exampleFor = (annualGross: number) => {
  const r = calc(annualGross, withholdingIncomeTax(withholdingTable, annualGross / 12, 1, 0));
  const incomeTax = must(r.incomeTax);
  const localTax = must(r.localTax);
  const total = must(r.totalDeduction);
  return {
    gross: r.monthlyGross,
    incomeTax,
    localTax,
    total,
    insurance: total - incomeTax - localTax,
    net: must(r.netMonthly),
  };
};
const won = (n: number) => new Intl.NumberFormat('ko-KR').format(n);
const ex40 = exampleFor(40000000);
const ex50 = exampleFor(50000000);
const ex60 = exampleFor(60000000);

const faqItems = [
  {
    q: '연봉 4천만원 직장인 월 실수령액은 얼마인가요?',
    a: `공제대상가족 1명(본인만), 8세 이상 20세 이하 자녀 0명, 비과세 급여 0원으로 이 계산기에 넣으면 월 실수령액은 ${won(ex40.net)}원입니다. 월 세전 ${won(ex40.gross)}원에서 4대보험(국민연금·건강·장기요양·고용) ${won(ex40.insurance)}원, 근로소득세 ${won(ex40.incomeTax)}원, 지방소득세 ${won(ex40.localTax)}원을 합한 ${won(ex40.total)}원이 빠집니다. 근로소득세는 근로소득 간이세액표에서 찾은 금액이라, 같은 연봉이라도 공제대상가족이 많거나 식대 같은 비과세 급여가 있으면 줄 수 있습니다.`,
  },
  {
    q: '연봉이 오른 만큼 실수령액이 늘지 않는 이유는?',
    a: `근로소득에 붙는 소득세는 종합소득 과세표준이 커질수록 높은 세율 구간(6%·15%·24%·35%·38%·40%·42%·45%)이 적용되는 누진 구조입니다(소득세법 제55조). 이 계산기에 공제대상가족 1명으로 연봉 5,000만원과 6,000만원을 넣으면 월 세전 급여는 ${won(ex60.gross - ex50.gross)}원 늘지만, 그중 근로소득세·지방소득세 ${won(ex60.incomeTax + ex60.localTax - ex50.incomeTax - ex50.localTax)}원과 4대보험 ${won(ex60.insurance - ex50.insurance)}원이 빠져 월 실수령액은 ${won(ex60.net - ex50.net)}원 늘어납니다.`,
  },
];

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '홈', item: Astro.site?.toString() },
    { '@type': 'ListItem', position: 2, name: '계산기', item: new URL('/calculators/', Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: '연봉 실수령액 계산기', item: url },
  ],
};

const tool = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '연봉 실수령액 계산기',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'All',
  url,
  description: '2026년 4대보험·근로소득세 기준 직장인 연봉 실수령액 즉시 계산.',
  inLanguage: 'ko-KR',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' },
};

const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const howTo = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: '연봉 실수령액 1분 안에 계산하는 법',
  description: '연봉만 입력하면 4대보험·소득세를 자동 차감해 월 실수령액을 알려주는 절차.',
  totalTime: 'PT1M',
  inLanguage: 'ko-KR',
  tool: [{ '@type': 'HowToTool', name: '머니룩 연봉 실수령액 계산기' }],
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: '연봉(세전) 입력',
      text: '근로계약서·연봉계약서에 명시된 연 환산 총급여를 만원 단위로 입력합니다. 예: 4,200만원.',
      url: `${url}#step-salary`,
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: '공제대상가족 수 입력',
      text: '본인과 배우자를 각각 1명으로 센 공제대상가족 수와, 그중 8세 이상 20세 이하 자녀 수를 입력합니다. 근로소득 간이세액표는 공제대상가족 수가 늘면 세액이 줄거나 그대로이고, 자녀 수에 따라 정해진 금액을 세액에서 더 뺍니다.',
      url: `${url}#step-dependents`,
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: '월 실수령액 확인',
      text: '입력 즉시 4대보험·근로소득세·지방세를 차감한 월 실수령액과 항목별 차감 내역이 표로 표시됩니다.',
      url: `${url}#step-result`,
    },
    {
      '@type': 'HowToStep',
      position: 4,
      name: '비과세·연말정산 영향 확인',
      text: '본 계산은 비과세 항목(식대·자가운전보조금)을 미반영합니다. 회사 급여명세서와 차이가 나면 비과세 적용 여부와 간이세액표 비율(80/100/120%) 선택을 확인하세요.',
      url: `${url}#explainer`,
    },
  ],
};
---
<Base
  title="연봉 실수령액 계산기 — 2026년 4대보험·세금 즉시 계산"
  description="연봉 입력만 하면 2026년 4대보험·근로소득세·지방세를 즉시 계산해 월 실수령액을 알려드립니다. 부양가족 인적공제 반영. 참고용."
  jsonLd={[breadcrumb, tool, howTo, faq]}
>
  <section class="hero">
    <div class="container">
      <nav aria-label="breadcrumb" class="crumb">
        <a href="/">홈</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">연봉 실수령액 계산기</span>
      </nav>
      <h1>연봉 실수령액 계산기</h1>
      <p class="lede">
        2026년 기준 4대보험 요율과 근로소득 간이세액표(2026년 3월 1일 이후 원천징수분)·지방소득세를 적용해 월 실수령액을 즉시 계산합니다.
        연봉만 입력하면 끝.
      </p>
    </div>
  </section>

  <section class="container body">
    <SalaryCalculator client:visible initialIncomeTax={initialIncomeTax} />

    <article class="explainer">
      <h2>이 계산기는 어떤 항목을 반영하나요?</h2>
      <p>
        2026년 근로자 부담 4대보험 요율(국민연금 4.75%, 건강보험 3.595%, 장기요양 건강보험료의 약 13.14%, 고용보험 0.9%)과
        국민연금 기준소득월액 상한 659만원(2026년 7월~2027년 6월)을 적용합니다.
      </p>
      <p>
        근로소득세는 소득세법 시행령 [별표 2] 근로소득 간이세액표(2026. 2. 27. 개정, 2026년 3월 1일 이후 원천징수분부터 적용)에서
        월급여액(연봉 ÷ 12)과 공제대상가족 수로 찾은 세액(100%)입니다. 표의 비고에 따라 8세 이상 20세 이하 자녀가 있으면
        자녀 1명 20,830원, 2명 45,830원, 3명 이상은 45,830원에 2명을 넘는 자녀 1명당 33,330원을 더한 금액을 빼고(빼고 남은 금액이
        음수면 0원), 월급여액 1,000만원 초과와 공제대상가족 11명 초과는 표에 적힌 계산식으로 구합니다. 11명 초과 계산식의 결과가
        0원보다 작은 경우는 원문에 규정이 없어 0원으로 표시합니다. 지방소득세는 근로소득세의 10%이며 10원 미만은 버립니다.
        원문은 <a href="https://www.law.go.kr/%EB%B2%95%EB%A0%B9/%EC%86%8C%EB%93%9D%EC%84%B8%EB%B2%95%EC%8B%9C%ED%96%89%EB%A0%B9" rel="noopener" target="_blank">국가법령정보센터 소득세법 시행령</a>의 별표 2에서 볼 수 있습니다.
      </p>
      <h2>실제 급여명세서와 차이가 날 수 있는 이유는?</h2>
      <ul>
        <li>비과세 항목(식대 월 20만원, 자가운전보조금 월 20만원, 보육수당 등) 반영 여부</li>
        <li>회사가 적용하는 간이세액표 비율(80%·100%·120%) 선택</li>
        <li>연말정산으로 환급·추가 납부되는 금액</li>
        <li>임원·고소득자의 국민연금 상한 적용</li>
      </ul>
      <h2>자주 묻는 질문</h2>
      {faqItems.map((f) => (
        <>
          <h3>{f.q}</h3>
          <p>{f.a}</p>
        </>
      ))}
      <p class="disclaimer">
        본 계산은 <strong>참고용</strong>입니다. 정확한 실수령액은 회사 급여명세서 또는
        <a href="https://www.nts.go.kr" rel="noopener" target="_blank">국세청 홈택스</a>·
        <a href="https://www.nps.or.kr" rel="noopener" target="_blank">국민연금공단</a> 공식 계산기를 참고하세요.
      </p>
    </article>
  </section>
</Base>

<style>
.container { max-width: 800px; padding-inline: 1rem; margin-inline: auto; }
@media (min-width: 768px) { .container { padding-inline: 2rem; } }

.hero {
  background: linear-gradient(180deg, var(--color-hero-from) 0%, var(--color-hero-to) 100%);
  padding-block: 2.5rem 1.5rem;
  border-bottom: 1px solid var(--color-border);
}
.crumb {
  display: flex;
  gap: 0.4rem;
  font-size: 0.8rem;
  color: var(--color-muted);
  margin-bottom: 1rem;
}
.crumb a:hover { color: var(--color-primary-700); }
.hero h1 {
  font-size: clamp(1.6rem, 4.5vw, 2.15rem);
  font-weight: 800;
  letter-spacing: -0.035em;
  color: var(--color-secondary);
  margin: 0 0 0.5rem;
}
.lede {
  font-size: 1rem;
  color: var(--color-muted);
  line-height: 1.65;
  margin: 0;
  max-width: 36rem;
}

.body { padding-block: 2rem 4rem; }

.explainer h2 {
  font-size: 1.2rem;
  font-weight: 800;
  margin: 1.75rem 0 0.5rem;
  color: var(--color-secondary);
  letter-spacing: -0.025em;
}
.explainer h3 {
  font-size: 1rem;
  font-weight: 700;
  margin: 1.25rem 0 0.35rem;
  color: var(--color-secondary);
  letter-spacing: -0.02em;
}
.explainer p, .explainer ul {
  font-size: 0.95rem;
  line-height: 1.7;
  color: var(--color-text);
}
.explainer ul { padding-left: 1.25rem; }
.explainer .disclaimer {
  background: var(--color-surface);
  border-left: 3px solid var(--color-primary);
  padding: 0.85rem 1rem;
  border-radius: 4px;
  font-size: 0.85rem;
  color: var(--color-muted);
  margin-top: 1.25rem;
}
.explainer a { color: var(--color-primary-700); text-decoration: underline; }

/* Calc styles */
:global(.calc) {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-card);
  overflow: hidden;
}
:global(.calc-controls) {
  padding: 1.25rem;
  background: var(--color-surface);
  border-bottom: 1px solid var(--color-border);
  display: grid;
  grid-template-columns: 1fr;
  gap: 1rem;
}
@media (min-width: 600px) {
  :global(.calc-controls) { grid-template-columns: 2fr 1fr; }
}
:global(.calc .field label) {
  display: block;
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--color-secondary);
  margin-bottom: 0.4rem;
}
:global(.calc .field input) {
  width: 100%;
  height: 44px;
  padding-inline: 0.85rem;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-btn);
  font-size: 1rem;
  font-weight: 600;
  background: var(--color-bg);
  color: var(--color-text);
}
:global(.calc .field-group) {
  display: grid;
  gap: 0.75rem;
  align-content: start;
}
:global(.calc .field .hint) {
  font-size: 0.75rem;
  color: var(--color-muted);
  line-height: 1.5;
  margin: 0.3rem 0 0;
}
:global(.calc .field input:focus) {
  outline: 2px solid var(--color-primary);
  outline-offset: 0;
  border-color: var(--color-primary);
}
:global(.calc .presets) {
  display: flex;
  flex-wrap: wrap;
  gap: 0.3rem;
  margin-top: 0.5rem;
}
:global(.calc .presets button) {
  height: 30px;
  padding-inline: 0.65rem;
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: 999px;
  font-size: 0.75rem;
  color: var(--color-muted);
  font-weight: 500;
}
:global(.calc .presets button.active),
:global(.calc .presets button:hover) {
  border-color: var(--color-primary);
  color: var(--color-primary-700);
  background: var(--color-mint-bg);
}
:global(.calc .result) { padding: 1.25rem; }
:global(.calc .result-headline) {
  text-align: center;
  padding-block: 1rem 1.25rem;
  border-bottom: 1px solid var(--color-border);
  margin-bottom: 1rem;
}
:global(.calc .result-headline .label) {
  font-size: 0.82rem;
  color: var(--color-muted);
  margin: 0 0 0.25rem;
}
:global(.calc .result-headline .value) {
  font-size: clamp(2rem, 7vw, 2.75rem);
  font-weight: 800;
  color: var(--color-primary-700);
  letter-spacing: -0.035em;
  margin: 0;
}
:global(.calc .result-headline .value span) { font-size: 0.5em; margin-left: 0.15em; color: var(--color-muted); font-weight: 700; }
:global(.calc .result-headline .sub) {
  font-size: 0.82rem;
  color: var(--color-muted);
  margin: 0.25rem 0 0;
}
:global(.calc .breakdown) {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.9rem;
}
:global(.calc .breakdown th) {
  text-align: left;
  font-weight: 600;
  font-size: 0.78rem;
  color: var(--color-muted);
  padding: 0.5rem 0.4rem;
  border-bottom: 1px solid var(--color-border);
}
:global(.calc .breakdown th:last-child),
:global(.calc .breakdown td:last-child) { text-align: right; font-variant-numeric: tabular-nums; }
:global(.calc .breakdown td) { padding: 0.5rem 0.4rem; border-bottom: 1px solid var(--color-border); }
:global(.calc .breakdown tr.total td) { font-weight: 600; background: var(--color-surface); }
:global(.calc .breakdown tr.net td) {
  background: var(--color-mint-bg);
  color: var(--color-primary-700);
  font-size: 1rem;
}
:global(.calc .note) {
  font-size: 0.78rem;
  color: var(--color-muted);
  line-height: 1.6;
  margin-top: 1rem;
  padding-block: 0.75rem 0;
  border-top: 1px dashed var(--color-border);
}
</style>
