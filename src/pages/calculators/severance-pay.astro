---
import Calculator from '../../layouts/Calculator.astro';
import SeverancePayCalculator from '../../components/SeverancePayCalculator';

const url = new URL('/calculators/severance-pay', Astro.site).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '홈', item: Astro.site?.toString() },
      { '@type': 'ListItem', position: 2, name: '계산기', item: new URL('/calculators', Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: '퇴직금 계산기', item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: '퇴직금 계산기',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'All',
    url,
    description: '근로기준법 기준 법정 퇴직금 + 예상 퇴직소득세 즉시 계산.',
    inLanguage: 'ko-KR',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: '법정 퇴직금 계산하는 법',
    description: '직전 3개월 평균임금과 근속 개월을 입력하면 법정 퇴직금과 예상 퇴직소득세를 즉시 산정.',
    totalTime: 'PT1M',
    inLanguage: 'ko-KR',
    tool: [{ '@type': 'HowToTool', name: '머니룩 퇴직금 계산기' }],
    step: [
      { '@type': 'HowToStep', position: 1, name: '직전 3개월 평균 월급여 입력', text: '퇴사 직전 3개월간 월 평균 임금(상여 포함)을 입력합니다.', url: `${url}#step-salary` },
      { '@type': 'HowToStep', position: 2, name: '총 근속 개월 입력', text: '입사일 ~ 퇴사일 기준 총 재직 개월을 입력합니다. 1년 미만은 법정 퇴직금이 발생하지 않습니다.', url: `${url}#step-tenure` },
      { '@type': 'HowToStep', position: 3, name: '결과 확인', text: '법정 퇴직금(1일 평균임금 × 30 × 근속연수)과 예상 퇴직소득세를 표로 표시합니다.', url: `${url}#step-result` },
    ],
  },
];
---
<Calculator
  title="퇴직금 계산기 — 평균임금·근속연수 기준 법정 퇴직금"
  description="근로기준법상 법정 퇴직금(평균임금 × 30일 × 근속연수)과 예상 퇴직소득세를 즉시 계산. 1년 이상 근속 시 발생."
  pageTitle="퇴직금 계산기"
  lede="최근 3개월 평균 월급여와 근속 개월만 입력하면 법정 퇴직금과 세후 예상 실수령액을 즉시 계산합니다."
  jsonLd={jsonLd}
>
  <SeverancePayCalculator client:visible />

  <article slot="explainer" class="explainer">
    <h2>퇴직금은 어떻게 계산되나요?</h2>
    <p>법정 퇴직금 = <strong>1일 평균임금 × 30일 × 근속연수</strong>입니다. 1일 평균임금은 직전 3개월 임금 총액을 90일로 나눈 값입니다 (근로기준법 제19조).</p>

    <h2>1년 미만 근로자도 받을 수 있나요?</h2>
    <p>법정 퇴직금은 <strong>1년 이상 근속</strong>해야 발생합니다. 다만 일부 회사는 단체협약·취업규칙으로 1년 미만에도 퇴직금을 지급할 수 있습니다. 근로계약서를 확인하세요.</p>

    <h2>DC형 퇴직연금에 가입되어 있다면?</h2>
    <p>회사가 매월 일정 금액을 IRP·DC 계좌에 적립하는 방식으로, 본 계산기와 다른 결과가 나옵니다. 가입 시점·운용 수익률에 따라 달라집니다.</p>

    <h2>퇴직소득세는 정확히 어떻게 적용되나요?</h2>
    <p>본 계산기는 단순 4~8% 비율로 추정합니다. 실제로는 근속연수공제 + 환산급여공제를 거친 후 누진세를 적용하므로 차이가 클 수 있습니다. 정확한 산정은 <a href="https://www.nts.go.kr" rel="noopener" target="_blank">국세청 홈택스 퇴직소득 자동계산</a>을 이용하세요.</p>
  </article>
</Calculator>

<style>
.explainer h2 {
  font-size: 1.15rem;
  font-weight: 800;
  margin: 1.75rem 0 0.5rem;
  color: var(--color-secondary);
  letter-spacing: -0.025em;
}
.explainer p {
  font-size: 0.95rem;
  line-height: 1.7;
  color: var(--color-text);
}
.explainer a { color: var(--color-primary-700); text-decoration: underline; }
</style>
