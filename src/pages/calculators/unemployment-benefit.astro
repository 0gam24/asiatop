---
import Calculator from '../../layouts/Calculator.astro';
import UnemploymentBenefitCalculator from '../../components/UnemploymentBenefitCalculator';

const url = new URL('/calculators/unemployment-benefit/', Astro.site).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '홈', item: Astro.site?.toString() },
      { '@type': 'ListItem', position: 2, name: '계산기', item: new URL('/calculators/', Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: '실업급여 계산기', item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: '실업급여 계산기',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'All',
    url,
    description: '직전 3개월 평균임금·연령·고용보험 가입기간 기반 예상 실업급여 즉시 계산.',
    inLanguage: 'ko-KR',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: '실업급여 예상 수령액 계산하는 법',
    description: '직전 3개월 평균임금·연령·고용보험 가입기간을 입력하면 일 구직급여와 총 수령액을 즉시 산정.',
    totalTime: 'PT1M',
    inLanguage: 'ko-KR',
    tool: [{ '@type': 'HowToTool', name: '머니룩 실업급여 계산기' }],
    step: [
      { '@type': 'HowToStep', position: 1, name: '평균임금 입력', text: '퇴사 직전 3개월 평균 일급 또는 월급을 입력합니다.', url: `${url}#step-wage` },
      { '@type': 'HowToStep', position: 2, name: '연령·가입기간 선택', text: '50세 미만/이상 여부와 고용보험 가입 총 기간을 선택해 소정급여일수를 결정합니다.', url: `${url}#step-period` },
      { '@type': 'HowToStep', position: 3, name: '예상 수령액 확인', text: '일 구직급여(2026년 64,192~66,000원 한도) × 소정급여일수로 총 수령액을 계산해 표시합니다.', url: `${url}#step-result` },
    ],
  },
];
---
<Calculator
  title="실업급여 계산기 — 일 구직급여·소정급여일수 즉시 계산"
  description="직전 3개월 평균임금·연령·고용보험 가입기간으로 일 구직급여와 총 수령액을 즉시 계산. 2026년 상하한 적용."
  pageTitle="실업급여 계산기"
  lede="2026년 일 구직급여 상하한(64,192~66,000원)과 소정급여일수를 적용한 예상 실업급여를 즉시 계산합니다."
  jsonLd={jsonLd}
>
  <UnemploymentBenefitCalculator client:visible />

  <article slot="explainer" class="explainer">
    <h2>실업급여는 누가 받을 수 있나요?</h2>
    <ul>
      <li><strong>이직 전 18개월 중 180일 이상</strong> 고용보험에 가입되어 있어야 함</li>
      <li><strong>비자발적 이직</strong>(권고사직·계약만료·경영상 해고 등)이어야 함</li>
      <li>이직 후 <strong>적극적 구직활동</strong>이 가능한 상태여야 함 (질병 등 즉시 취업이 불가하면 수급 연기)</li>
      <li>실업 신고 후 <strong>실업인정일에 출석</strong>하여 구직활동 보고</li>
    </ul>

    <h2>일 구직급여는 어떻게 계산되나요?</h2>
    <p>일 구직급여 = <strong>이직 전 3개월 평균임금 × 60%</strong>로 산정하되, 2026년 기준 일 상한 <strong>66,000원</strong>·하한 <strong>64,192원</strong>(최저시급 80%)이 적용됩니다.</p>

    <h2>소정급여일수는 어떻게 결정되나요?</h2>
    <table>
      <thead>
        <tr><th>고용보험 가입 기간</th><th>50세 미만</th><th>50세 이상·장애인</th></tr>
      </thead>
      <tbody>
        <tr><td>1년 미만</td><td>120일</td><td>120일</td></tr>
        <tr><td>1~3년</td><td>150일</td><td>180일</td></tr>
        <tr><td>3~5년</td><td>180일</td><td>210일</td></tr>
        <tr><td>5~10년</td><td>210일</td><td>240일</td></tr>
        <tr><td>10년 이상</td><td>240일</td><td>270일</td></tr>
      </tbody>
    </table>

    <h2>자발적 퇴사도 받을 수 있는 경우가 있나요?</h2>
    <p>다음 사유는 "정당한 사유"로 인정되어 수급 가능합니다:</p>
    <ul>
      <li>임금 체불·지연 지급 (2개월 이상)</li>
      <li>최저임금 미만 지급</li>
      <li>장시간 근로(주 52시간 초과)</li>
      <li>직장 내 괴롭힘·성희롱</li>
      <li>통근 곤란(왕복 3시간 이상)</li>
      <li>가족 간병·임신·출산 등</li>
    </ul>
    <p>증빙 서류 준비 후 <a href="https://www.ei.go.kr" rel="noopener" target="_blank">고용보험 홈페이지</a> 또는 가까운 고용센터에서 상담받으세요.</p>
  </article>
</Calculator>

<style>
.explainer h2 { font-size: 1.15rem; font-weight: 800; margin: 1.75rem 0 0.5rem; color: var(--color-secondary); letter-spacing: -0.025em; }
.explainer p, .explainer ul { font-size: 0.95rem; line-height: 1.7; color: var(--color-text); }
.explainer ul { padding-left: 1.25rem; }
.explainer table { width: 100%; border-collapse: collapse; margin-block: 1rem; font-size: 0.9rem; }
.explainer th, .explainer td { border: 1px solid var(--color-border); padding: 0.5rem 0.75rem; text-align: left; }
.explainer th { background: var(--color-surface); font-weight: 700; }
.explainer a { color: var(--color-primary-700); text-decoration: underline; }
</style>
