---
import Base from '../layouts/Base.astro';
import { clusters } from '../data/clusters';

const url = new URL('/about/', Astro.site).toString();
const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  url,
  name: '머니룩 소개',
  inLanguage: 'ko-KR',
  about: {
    '@id': new URL('#organization', Astro.site).toString(),
  },
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '홈', item: Astro.site?.toString() },
    { '@type': 'ListItem', position: 2, name: '머니룩 소개', item: url },
  ],
};

// R52-B: SoftwareApplication schema — 머니룩 자동검증시스템을 schema.org
// SoftwareApplication 으로 노출. 기존 자동 발행 글(aiAssisted)의 reviewedBy/creditText 와 연결.
// 2026-06-11 자동 발행 폐기 — 시스템은 2026-06 이전 발행분 검증 이력으로만 유효 (과거형 서술).
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': new URL('/about/#auto-verification-pipeline', Astro.site).toString(),
  name: 'MoneyLook 자동검증시스템 (G0~G9, 2026-06 이전 발행분)',
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: 'Editorial Content Verification Pipeline',
  operatingSystem: 'Cross-platform (Cloud)',
  inLanguage: 'ko-KR',
  description: '2026년 6월 이전 자동 발행 콘텐츠에 적용된 10단계 검증 파이프라인. 1차 정부 자료(공공데이터·법제처·홈택스·복지로·한국은행 ECOS·고용24·국민연금공단·금융감독원)와 자동 1:1 매칭 — G0 중복 → G1 PII/욕설/정치 → G2 클러스터 매핑 → G3 권위 출처 가용성 → G4 사실 1:1 매칭(임계 70%) → G5 AdSense 정책 → G6 YMYL/AI 면책 → G7 표절 → G8 AI다움 → G9 Naver 스팸. 2026년 6월부터 신규 글은 편집팀이 수동 작성하며 1차 출처를 직접 확인·검수합니다.',
  publisher: { '@id': new URL('#organization', Astro.site).toString() },
  creator: { '@id': new URL('#organization', Astro.site).toString() },
  url: new URL('/editorial-policy/', Astro.site).toString(),
  isAccessibleForFree: true,
  offers: {
    '@type': 'Offer',
    price: 0,
    priceCurrency: 'KRW',
  },
  featureList: [
    '정부·공공 1차 자료 1:1 사실 매칭',
    'AdSense YMYL 정책 자동 준수',
    '표절·LLM 부산물·Naver 스팸 4룰 자동 차단',
    'IndexNow + WebSub + Naver/Bing/Yandex 동시 push',
    '24시간 정정 정책',
  ],
  audience: {
    '@type': 'Audience',
    audienceType: '한국 직장인·청년',
    geographicArea: { '@type': 'Country', name: 'South Korea', sameAs: 'https://www.wikidata.org/wiki/Q884' },
  },
};
---
<Base
  title="머니룩 소개 — 직장인·청년 생활금융 종합 가이드"
  description="머니룩은 공공데이터포털·법제처·홈택스·복지로·한국은행 ECOS 등 1차 정부·공공 자료에 기반해 한국 직장인·청년이 매일 마주치는 돈 문제를 풀어 설명하는 생활금융 미디어입니다."
  jsonLd={[breadcrumbSchema, aboutSchema, softwareSchema]}
>
  <article class="container narrow">
    <header>
      <p class="kicker">About</p>
      <h1>매일 새는 월급, 한곳에서 정리해드립니다.</h1>
      <p class="lede">
        머니룩(MoneyLook)은 한국 직장인·청년이 매일 마주치는 돈 문제를 1차 정부 자료에 기반해
        풀어 설명하는 생활금융 미디어입니다.
      </p>
    </header>

    <section class="prose">
      <h2>왜 머니룩인가요?</h2>
      <p>
        직장인이 받을 수 있는 정부 지원금은 매년 수백 가지가 신설·개편됩니다. 세금환급·실업급여·청년정책·
        4대보험 등 한 사람당 1년에 평균 23만원 이상의 환급·지원을 놓친다는 국세청·복지부 통계가 있습니다.
        머니룩은 이 정보 격차를 줄이는 데 집중합니다.
      </p>

      <h2>어떻게 신뢰할 수 있나요?</h2>
      <ul>
        <li><strong>1차 정부 자료 직접 인용</strong> — 공공데이터포털(data.go.kr)·법제처(law.go.kr)·홈택스·복지로·한국은행 ECOS 등 공식 출처 URL을 모든 글에 명시해 누구나 검증할 수 있도록 합니다.</li>
        <li><strong>편집팀 직접 작성·검수</strong> — 2026년 6월부터 모든 신규 글은 편집팀이 1차 정부·공공 출처를 직접 확인해 수동으로 작성합니다. 추정·변동 수치는 "약 N" 근사 표현으로 구분 표기하고, 법정·공시 수치는 법령 조문·공식 안내를 확인한 뒤에만 단정 표기합니다. 다만 자격 보유 전문가의 직접 검수는 받지 않으므로, 본 글은 일반 정보 제공이지 세무·법률·재무 자문이 아닙니다.</li>
        <li><strong>과거 자동 발행분의 검증 이력</strong> — 2026년 6월 이전 AI 보조로 발행된 글(본문 끝 AI 보조 사용 공시 부착)은 발행 당시 10단계 자동 게이트(G0~G9: 중복 차단·PII·cluster 매핑·권위 소스·사실 매칭(임계 70%)·AdSense 정책·면책 부착·표절 검사·AI 자연체·Naver 스팸)를 통과했으며, 해당 글에는 검증 상세 내역이 표시됩니다.</li>
        <li><strong>정정 정책</strong> — 사실 오류 발견 시 24시간 이내 정정하고 글 하단에 정정 이력을 표기합니다.</li>
        <li><strong>최종 확인 책임</strong> — 정확한 신청 자격·요율·법령은 신청 직전 해당 기관 공식 안내에서 재확인하시기 바랍니다.</li>
      </ul>

      <h2>어떤 주제를 다루나요?</h2>
      <p>12개 카테고리에서 직장인·청년이 가장 많이 검색하는 돈 문제를 다룹니다:</p>
      <ul>
        {clusters.map((c) => (
          <li>
            <strong>{c.title}</strong> — {c.description}
          </li>
        ))}
      </ul>

      <h2>운영 정책</h2>
      <ul>
        <li><a href="/editorial-policy/">편집 정책</a> — 사실 확인·정정·AI 사용 정책</li>
        <li><a href="/privacy/">개인정보처리방침</a> — 한국 개인정보보호법 준수</li>
        <li><a href="/terms/">이용약관</a></li>
        <li><a href="/contact/">문의·제휴</a></li>
      </ul>

      <h2>광고·수익 정책</h2>
      <p>
        머니룩은 Google AdSense를 통해 광고 수익을 받습니다. 광고는 콘텐츠와 명확히 구분되며,
        모든 추천·비교·제휴 콘텐츠는 본문에 "[제휴]" 또는 "[광고]"로 명시합니다. 우리는 광고주로부터
        편집 방향에 영향을 받지 않습니다.
      </p>

      <h2>운영자 소개</h2>
      <p>
        <strong>김준혁</strong>이 직접 운영합니다. 스마트데이터샵(사업자등록 406-06-34485) 대표로
        2020년 5월부터 전자상거래·해외직구대행업과 함께 머니룩을 만들었습니다. 자격증을 보유한
        전문가는 아니며, 본 사이트의 글은 일반 정보 제공이지 세무·법률·재무 자문이 아닙니다.
        모든 법령·요율·정책 정보는 정부 공식 1차 자료에서 직접 확인합니다.
      </p>
      <p>
        ▶ <a href="/author/kim-junhyeok/"><strong>운영자 상세 프로필 보기</strong></a>
      </p>

      <h2>사업자 정보</h2>
      <ul>
        <li><strong>상호</strong>: 스마트데이터샵 (서비스명: 머니룩 MoneyLook)</li>
        <li><strong>대표</strong>: <a href="/author/kim-junhyeok/">김준혁</a></li>
        <li><strong>사업자등록번호</strong>: 406-06-34485</li>
        <li><strong>개업일</strong>: 2020년 5월 21일</li>
        <li><strong>주소</strong>: 인천광역시 계양구 새벌로 88</li>
        <li><strong>이메일</strong>: <a href="mailto:smartdatashop@gmail.com">smartdatashop@gmail.com</a> (모든 문의 단일 창구)</li>
      </ul>
    </section>
  </article>
</Base>

<style>
.container { max-width: 760px; padding-inline: 1rem; margin-inline: auto; }
.narrow { padding-block: 2.5rem 4rem; }
.kicker {
  display: inline-flex;
  height: 26px;
  padding-inline: 0.6rem;
  background: var(--color-mint-bg);
  color: var(--color-primary-700);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  border-radius: 999px;
  text-transform: uppercase;
  margin: 0 0 1rem;
}
h1 {
  font-size: clamp(1.8rem, 5vw, 2.4rem);
  font-weight: 800;
  letter-spacing: -0.035em;
  color: var(--color-secondary);
  line-height: 1.25;
  margin: 0 0 0.85rem;
}
.lede {
  font-size: 1.1rem;
  color: var(--color-muted);
  line-height: 1.7;
  margin: 0 0 2.5rem;
  max-width: 36rem;
}
</style>
