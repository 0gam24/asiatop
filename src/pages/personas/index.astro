---
import Base from '../../layouts/Base.astro';

const url = new URL('/personas/', Astro.site).toString();
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '홈', item: Astro.site?.toString() },
    { '@type': 'ListItem', position: 2, name: '페르소나', item: url },
  ],
};

const personas = [
  {
    slug: 'social-newbie',
    title: '사회초년생',
    description: '취업·첫 월급·청년 자산 형성·정부 무료 교육·신용 점수까지 1~3년 차 직장인이 마주치는 12편.',
    emoji: '🎓',
    accent: '#00C896',
    coverCount: 12,
  },
  {
    slug: 'newlywed',
    title: '신혼·신생아',
    description: '결혼·출산·첫집 마련을 앞둔 신혼부부의 청약·전세·세제·지원금 통합 가이드.',
    emoji: '💍',
    accent: '#FF6B9D',
    coverCount: 11,
  },
  {
    slug: 'housing-subscription',
    title: '청약',
    description: '청약통장·가점제·1순위·디딤돌·버팀목까지 첫집 청약 의사결정에 필요한 9편.',
    emoji: '🏠',
    accent: '#5B8DEF',
    coverCount: 9,
  },
  {
    slug: 'self-employed',
    title: '자영업자·프리랜서',
    description: '종합소득세·부가세·사업자등록·정책대출·노란우산·자영업자 실업급여 10편.',
    emoji: '💼',
    accent: '#FFB800',
    coverCount: 10,
  },
];

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: '페르소나별 가이드 | 머니룩',
  description: '신혼·신생아·청약 등 인생 단계별로 묶은 머니룩 가이드 큐레이션.',
  url,
  inLanguage: 'ko-KR',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: personas.length,
    itemListElement: personas.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(`/personas/${p.slug}/`, Astro.site).toString(),
      name: p.title,
    })),
  },
};
---
<Base
  title="페르소나별 가이드 | 머니룩"
  description="신혼·신생아·청약 등 인생 단계별로 머니룩 108편을 횡단 큐레이션한 가이드 페이지."
  jsonLd={[breadcrumbSchema, collectionSchema]}
>
  <article class="container narrow">
    <header>
      <p class="kicker">Personas</p>
      <h1>인생 단계별 가이드</h1>
      <p class="lede">
        12개 카테고리를 가로질러, 인생 단계별로 필요한 글을 한 자리에 모았습니다. 결혼·출산·첫집 청약같이
        여러 카테고리에 걸친 문제를 한 페이지에서 따라가세요.
      </p>
    </header>

    <ul class="grid" role="list">
      {personas.map((p) => (
        <li class="card" style={`--accent: ${p.accent};`}>
          <a href={`/personas/${p.slug}/`} class="card-link">
            <div class="emoji" aria-hidden="true">{p.emoji}</div>
            <h2>{p.title}</h2>
            <p>{p.description}</p>
            <span class="count">{p.coverCount}편 큐레이션 →</span>
          </a>
        </li>
      ))}
    </ul>
  </article>
</Base>

<style>
  .container { max-width: 960px; padding-inline: 1rem; margin-inline: auto; padding-block: 2.5rem 4rem; }
  .narrow { }
  .kicker {
    display: inline-flex; height: 26px; padding-inline: 0.6rem;
    background: var(--color-mint-bg); color: var(--color-primary-700);
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em;
    border-radius: 999px; text-transform: uppercase; margin: 0 0 1rem;
  }
  h1 { font-size: clamp(1.8rem, 5vw, 2.4rem); font-weight: 800; letter-spacing: -0.035em; color: var(--color-secondary); margin: 0 0 0.85rem; }
  .lede { font-size: 1.06rem; color: var(--color-muted); line-height: 1.7; margin: 0 0 2.5rem; max-width: 36rem; }

  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: 1rem; }
  @media (min-width: 640px) { .grid { grid-template-columns: 1fr 1fr; } }

  .card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s;
  }
  .card:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(0,0,0,0.08); border-color: color-mix(in oklab, var(--accent) 40%, var(--color-border)); }
  .card-link { display: block; padding: 1.5rem; color: inherit; text-decoration: none; }
  .emoji { font-size: 2.2rem; line-height: 1; margin-bottom: 0.85rem; }
  .card h2 { font-size: 1.25rem; font-weight: 800; color: var(--color-secondary); margin: 0 0 0.5rem; letter-spacing: -0.025em; }
  .card p { color: var(--color-muted); font-size: 0.92rem; line-height: 1.6; margin: 0 0 0.85rem; }
  .count { color: var(--accent); font-size: 0.85rem; font-weight: 700; }
</style>
