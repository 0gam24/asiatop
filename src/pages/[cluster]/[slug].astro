---
import Base from '../../layouts/Base.astro';
import { findCluster, clusterAccentDark } from '../../data/clusters';
import { getCollection, getEntry, render } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import HeroIllustration from '../../components/HeroIllustration.astro';
import SourceVerificationBadge from '../../components/SourceVerificationBadge.astro';
import VerificationDetails from '../../components/VerificationDetails.astro';
import MainBackrefBox from '../../components/MainBackrefBox.astro';
import { getRelatedArticles } from '../../lib/related-articles';

export async function getStaticPaths() {
  let articles: Awaited<ReturnType<typeof getCollection>> = [];
  try {
    articles = await getCollection('articles', ({ data }) => !data.draft);
  } catch {
    return [];
  }
  return articles.map((article) => ({
    params: {
      cluster: article.data.cluster,
      slug: article.id.replace(/\.mdx?$/, ''),
    },
    props: { article, allArticles: articles },
  }));
}

const { article, allArticles } = Astro.props;
const cluster = findCluster(article.data.cluster);
const { Content } = await render(article);

const authorEntry = await getEntry('authors', article.data.author).catch(() => undefined);

const relatedArticles = getRelatedArticles(article, allArticles, 6);

// 같은 클러스터 내 publishedAt 기준 prev/next — Schema.org Article previousItem/nextItem
const sameClusterSorted = allArticles
  .filter((a) => a.data.cluster === article.data.cluster && !a.data.draft)
  .sort((a, b) => a.data.publishedAt.valueOf() - b.data.publishedAt.valueOf());
const idx = sameClusterSorted.findIndex((a) => a.id === article.id);
const prevArticle = idx > 0 ? sameClusterSorted[idx - 1] : null;
const nextArticle = idx < sameClusterSorted.length - 1 ? sameClusterSorted[idx + 1] : null;
const prevUrl = prevArticle
  ? new URL(`/${prevArticle.data.cluster}/${prevArticle.id.replace(/\.mdx?$/, '')}/`, Astro.site).toString()
  : null;
const nextUrl = nextArticle
  ? new URL(`/${nextArticle.data.cluster}/${nextArticle.id.replace(/\.mdx?$/, '')}/`, Astro.site).toString()
  : null;

const slug = article.id.replace(/\.mdx?$/, '');
const url = new URL(`/${article.data.cluster}/${slug}/`, Astro.site).toString();
const ogImagePath = `/og/${article.data.cluster}/${slug}.png`;
const heroImage = new URL(`/og/${article.data.cluster}/${slug}.png`, Astro.site).toString();
const heroImageSvg = new URL(`/og/${article.data.cluster}/${slug}.svg`, Astro.site).toString();
// R65 — 1:1 정사각형 OG variant (Perplexity·Discover 모바일 카드 우위).
// Google Article schema 권장: 16:9 + 1:1 두 비율 동시 노출.
const heroImageSquare = new URL(`/og-square/${article.data.cluster}/${slug}.png`, Astro.site).toString();
const heroImageSquareSvg = new URL(`/og-square/${article.data.cluster}/${slug}.svg`, Astro.site).toString();

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '홈', item: Astro.site?.toString() },
    { '@type': 'ListItem', position: 2, name: cluster?.title ?? '', item: new URL(`/${article.data.cluster}/`, Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: article.data.title, item: url },
  ],
};

const authorUrl = authorEntry
  ? new URL(`/author/${authorEntry.id}/`, Astro.site).toString()
  : new URL('/about/', Astro.site).toString();
const authorSchema = authorEntry
  ? {
      '@type': authorEntry.data.isOrganization ? 'Organization' : 'Person',
      '@id': `${authorUrl}#author`,
      name: authorEntry.data.name,
      jobTitle: authorEntry.data.jobTitle,
      url: authorUrl,
      description: authorEntry.data.bio,
      knowsAbout: authorEntry.data.expertise,
      sameAs: authorEntry.data.sameAs,
      ...(authorEntry.data.isOrganization
        ? {
            // Organization author — 사이트 공용 로고 자산 사용 (public/logo-square-light.svg)
            logo: {
              '@type': 'ImageObject',
              url: new URL('/logo-square-light.svg', Astro.site).toString(),
            },
          }
        : {
            worksFor: { '@id': new URL('#organization', Astro.site).toString() },
            // Person.image — authors collection 에 image 값이 실제 존재할 때만 매핑
            ...(authorEntry.data.image
              ? { image: new URL(authorEntry.data.image, Astro.site).toString() }
              : {}),
          }),
    }
  : {
      '@type': 'Organization',
      name: '머니룩 편집팀',
      url: new URL('/about/', Astro.site).toString(),
    };

// wordCount: 한국어 기준 어절 단위 (공백 분리). MDX 마크다운 syntax/HTML/코드블록 제거 후 계수.
const cleanBody = (article.body ?? '')
  .replace(/```[\s\S]*?```/g, ' ')
  .replace(/<[^>]+>/g, ' ')
  .replace(/!\[[^\]]*\]\([^)]+\)/g, ' ')
  .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
  .replace(/[#*_`>~|-]/g, ' ');
const wordCount = cleanBody.trim().split(/\s+/).filter(Boolean).length;
const articleBodyExcerpt = cleanBody.replace(/\s+/g, ' ').trim().slice(0, 500);

// 한국어 평독 속도 ≈ 350 어절/분 (한국어능력검정 기준 평균). 분 단위 반올림, 최소 1분.
const readingMinutes = Math.max(1, Math.round(wordCount / 350));
const timeRequiredISO = `PT${readingMinutes}M`;

// Article.citation — 본문 출처 URL을 schema citation으로 노출 (E-E-A-T 강화)
const citationList = article.data.sources.map((s) => ({
  '@type': 'CreativeWork',
  name: s.title,
  url: s.url,
}));

// ToC: MDX 본문에서 ## H2 추출 (코드블록 내부 ## 제외).
// 슬러그는 Astro MDX의 기본 GitHub-flavored slugger와 일치 — 공백 → 하이픈, ? . ! 등 제거.
function slugify(text: string): string {
  return text
    .trim()
    .replace(/[?!.,:;'"`()[\]{}]/g, '')
    .replace(/\s+/g, '-')
    .toLowerCase();
}
const tocItems: { text: string; slug: string }[] = [];
{
  const body = article.body ?? '';
  let inFence = false;
  for (const line of body.split(/\r?\n/)) {
    if (/^\s*```/.test(line)) {
      inFence = !inFence;
      continue;
    }
    if (inFence) continue;
    const m = line.match(/^##\s+(.+?)\s*$/);
    if (m && m[1]) {
      const text = m[1].replace(/[*_`]/g, '');
      tocItems.push({ text, slug: slugify(text) });
    }
  }
}

// Article.hasPart — ToC 항목을 schema 챕터로 노출
const hasPartList = tocItems.map((t) => ({
  '@type': 'WebPageElement',
  name: t.text,
  url: `${url}#${t.slug}`,
}));

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': article.data.articleType ?? 'Article',
  headline: article.data.title,
  description: article.data.description,
  url,
  image: [heroImage, heroImageSquare, heroImageSvg, heroImageSquareSvg],
  thumbnailUrl: heroImage,
  datePublished: article.data.publishedAt.toISOString(),
  dateModified: (article.data.updatedAt ?? article.data.publishedAt).toISOString(),
  inLanguage: 'ko-KR',
  wordCount,
  timeRequired: timeRequiredISO,
  // R48 #48-3 — lastReviewed 우선순위: frontmatter → 자동검증시점 → dataValidAsOf 파싱.
  // YMYL 콘텐츠 신선도 시그널 — Article.dateModified와 별도. AI 답변 엔진이 "최근 검증" 청크를 우선 인용.
  ...(article.data.lastReviewed
    ? { lastReviewed: article.data.lastReviewed.toISOString().slice(0, 10) }
    : article.data.fact_verification_at
    ? { lastReviewed: article.data.fact_verification_at.slice(0, 10) }
    : article.data.dataValidAsOf
    ? (() => {
        const m = article.data.dataValidAsOf.match(/^(\d{4})년\s*(\d{1,2})월$/);
        return m
          ? { lastReviewed: `${m[1]}-${m[2].padStart(2, '0')}-01` }
          : {};
      })()
    : {}),
  articleBody: articleBodyExcerpt,
  citation: citationList,
  hasPart: hasPartList,
  ...(prevUrl
    ? {
        previousItem: {
          '@type': 'Article',
          url: prevUrl,
          name: prevArticle!.data.title,
        },
      }
    : {}),
  ...(nextUrl
    ? {
        nextItem: {
          '@type': 'Article',
          url: nextUrl,
          name: nextArticle!.data.title,
        },
      }
    : {}),
  // mainEntity — 글의 핵심 Q&A (AI Overviews·Perplexity 인용 가능성 ↑)
  mainEntity: article.data.aiCitationQuestions[0]
    ? {
        '@type': 'Question',
        name: article.data.aiCitationQuestions[0],
        acceptedAnswer: {
          '@type': 'Answer',
          text: article.data.description,
          url,
        },
      }
    : undefined,
  copyrightYear: article.data.publishedAt.getFullYear(),
  copyrightHolder: { '@id': new URL('#organization', Astro.site).toString() },
  license: new URL('/terms/', Astro.site).toString(),
  audience: {
    '@type': 'Audience',
    audienceType: '한국 직장인·청년',
    geographicArea: { '@type': 'Country', name: 'South Korea' },
  },
  author: authorSchema,
  // R48 #48-3 — 과거 자동 발행 글(aiAssisted=true)에 reviewedBy + creditText 명시.
  // 사람 사칭 페널티 회피. 파이프라인은 2026-06 폐기 — 과거형 서술만 허용 (PR-B).
  ...(article.data.aiAssisted
    ? {
        reviewedBy: { '@id': `${authorUrl}#author` },
        creditText: 'MoneyLook 자동검증시스템 (발행 당시 G0~G9 10단계 게이트 통과)',
      }
    : article.data.reviewedBy
    ? {
        reviewedBy: {
          '@id': new URL(`/author/${article.data.reviewedBy}/`, Astro.site).toString() + '#author',
        },
      }
    : {}),
  publisher: {
    '@type': 'Organization',
    '@id': new URL('#organization', Astro.site).toString(),
    name: '머니룩',
    parentOrganization: {
      '@type': 'Organization',
      name: '스마트데이터샵',
      url: 'https://smartdatashop.kr',
    },
    logo: {
      '@type': 'ImageObject',
      url: new URL('/logo.svg', Astro.site).toString(),
      width: 600,
      height: 60,
    },
  },
  isBasedOn: 'https://smartdatashop.kr/',
  mainEntityOfPage: url,
  // R67 — about 의 첫 항목은 cluster 자체 entity (Wikipedia·정부기관 sameAs) 로 Google KG + AI 엔진 entity 인식 강화
  about: [
    ...(cluster?.entityRefs && cluster.entityRefs.length > 0
      ? [{
          '@type': 'Thing',
          name: cluster.title,
          sameAs: cluster.entityRefs,
        }]
      : []),
    ...article.data.keywords.map((k) => ({ '@type': 'Thing', name: k })),
  ],
  keywords: article.data.keywords.join(', '),
  articleSection: cluster?.title,
  isPartOf: {
    '@type': 'CollectionPage',
    name: cluster?.title,
    url: new URL(`/${article.data.cluster}/`, Astro.site).toString(),
  },
  // 음성 어시스턴트(Google Assistant·Alexa) — 다루는 질문 + lede 우선 음성 출력
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.cite-questions', '.lede', 'h1'],
  },
};

// FAQPage schema — faq frontmatter Q&A pair (실 답변 보유) 글에만 생성.
// aiCitationQuestions fallback (전 질문에 동일 description 답변 복제) 은 제거 —
// 동일 답변 복제는 FAQ rich result 가치 없음 + 대규모 중복 텍스트 리스크.
// faq 없으면 null (jsonLdList 에서 자동 제외).
const faqSchema = article.data.faq && article.data.faq.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: article.data.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;

// QAPage — 자동 발행 글에 source_question 메타데이터 있으면 자동 생성
// AI 검색 엔진(Perplexity·ChatGPT)의 인용 가능성 ↑.
// 단, 지식인 원문 인용 X (네이버 ToS) — 질문은 의역 재작성된 frontmatter 값만 사용.
const qaSchema = article.data.source_question_text
  ? {
      '@context': 'https://schema.org',
      '@type': 'QAPage',
      mainEntity: {
        '@type': 'Question',
        name: article.data.source_question_text,
        text: article.data.source_question_text,
        upvoteCount: article.data.source_signal?.unmet_market_score ?? 0,
        answerCount: 1,
        acceptedAnswer: {
          '@type': 'Answer',
          text: article.data.description,
          author: { '@id': `${authorUrl}#author` },
          dateCreated: article.data.publishedAt.toISOString(),
          ...(article.data.sources_verified
            ? {
                citation: article.data.sources.map((s) => ({
                  '@type': 'CreativeWork',
                  name: s.title,
                  url: s.url,
                })),
              }
            : {}),
        },
      },
    }
  : null;

// self-ClaimReview(자기 글 5/5 평가)·Dataset 스키마는 2026-06-12 제거 (docs/23 §3-3 PR-B).
// sources_verified=true 글 0편으로 휴면이었고, 자기 평가 ClaimReview 와 일반 글의
// Dataset 가장은 구조화 데이터 과대표시 — 검증 이력 공시는 VerificationDetails UI 로 충분.

// R50-6: HowTo schema 자동 추출 — 절차형 클러스터(gov-support·public-services·
// tax·insurance-labor·unemployment) 글에서 본문 H2 패턴 "## 1. xxx", "## 2. xxx"
// ≥ 3개 시 HowTo schema 자동 생성. AI Overviews·Naver Clova rich result 인용 ↑.
const PROCEDURAL_CLUSTERS = ['gov-support', 'public-services', 'tax', 'insurance-labor', 'unemployment'];
function extractHowToSteps(body: string) {
  const lines = body.split(/\r?\n/);
  let inFence = false;
  const steps: { name: string; index: number }[] = [];
  for (const line of lines) {
    if (/^\s*```/.test(line)) {
      inFence = !inFence;
      continue;
    }
    if (inFence) continue;
    const m = line.match(/^##\s+(\d+)\.\s+(.+?)\s*$/);
    if (m) {
      steps.push({ index: parseInt(m[1], 10), name: m[2].replace(/[*_`]/g, '').trim() });
    }
  }
  return steps;
}
const howToSchema = (() => {
  if (!PROCEDURAL_CLUSTERS.includes(article.data.cluster)) return null;
  const steps = extractHowToSteps(article.body ?? '');
  if (steps.length < 3) return null;
  return {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: article.data.title,
    description: article.data.description,
    inLanguage: 'ko-KR',
    totalTime: `PT${Math.max(5, steps.length * 3)}M`, // step당 3분 가정, 최소 5분
    step: steps.map((s) => ({
      '@type': 'HowToStep',
      position: s.index,
      name: s.name,
      url: `${url}#${slugify(s.name)}`,
    })),
  };
})();

const jsonLdList = [
  breadcrumbSchema,
  articleSchema,
  ...(faqSchema ? [faqSchema] : []),
  ...(qaSchema ? [qaSchema] : []),
  ...(howToSchema ? [howToSchema] : []),
];

const dateStr = new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' }).format(article.data.publishedAt);
const updateStr = article.data.updatedAt
  ? new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' }).format(article.data.updatedAt)
  : null;

// byline — authors collection 의 name 우선, 없으면 frontmatter author 문자열 그대로
const authorName = authorEntry?.data.name ?? article.data.author;
const authorProfileHref = authorEntry ? `/author/${authorEntry.id}/` : null;

// 저자 박스 bio 요약 — 1~2문장만 (author 프로필 페이지와의 대규모 본문 중복 방지.
// 긴 bio 전문 삽입 금지 — 451페이지 동일 텍스트 복제 리스크).
const authorBioSummary = authorEntry
  ? (() => {
      const max = 180;
      const sentences = authorEntry.data.bio.split(/(?<=다\.)\s+/).filter(Boolean);
      let summary = sentences[0] ?? '';
      if (sentences[1] && summary.length + sentences[1].length + 1 <= max) {
        summary = `${summary} ${sentences[1]}`;
      }
      return summary.length > max ? `${summary.slice(0, max).trimEnd()}…` : summary;
    })()
  : null;

// 검수 표기 (사실 그대로만) — aiAssisted=false 글만 표기.
// 전문가 호칭 금지: 저자 bio 가 "자격 보유 전문가 검수 없음" 명시 고지 중 — 모순 금지.
// aiAssisted=true 글은 VerificationDetails 가 검증 표기를 담당하므로 라벨 생략.
// 2026-08-26 P2 정직성 가드 (docs/24): 수동 전환일(2026-06-11) 이전 발행분은 운영자가
// 직접 집필하지 않았을 수 있으므로 "책임 편집", 이후 발행분만 "작성·검수" 로 구분.
const MANUAL_ERA_START = new Date('2026-06-11');
const reviewLabel = article.data.publishedAt < MANUAL_ERA_START ? '책임 편집' : '작성·검수';
const reviewLine = !article.data.aiAssisted ? `${reviewLabel}: ${authorName} · ${updateStr ?? dateStr}` : null;

const referenceDate = article.data.updatedAt ?? article.data.publishedAt;
const ageInDays = Math.floor((Date.now() - referenceDate.valueOf()) / (1000 * 60 * 60 * 24));
const isStale = ageInDays > 180;
const isVeryStale = ageInDays > 365;
const ageMonths = Math.floor(ageInDays / 30);
---
<Base
  title={article.data.title}
  description={article.data.description}
  ogType="article"
  ogImage={ogImagePath}
  jsonLd={jsonLdList}
  articleMeta={{
    section: cluster?.title,
    tags: article.data.keywords as string[],
    publishedTime: article.data.publishedAt.toISOString(),
    modifiedTime: (article.data.updatedAt ?? article.data.publishedAt).toISOString(),
    author: authorEntry?.data.name ?? '머니룩 편집팀',
  }}
  prevHref={prevUrl ?? undefined}
  nextHref={nextUrl ?? undefined}
  newsKeywords={article.data.keywords as string[]}
>
  <article
    class="article"
    data-pagefind-body
    data-pagefind-filter={`cluster:${cluster?.title ?? ''}`}
    data-pagefind-meta={`cluster:${cluster?.shortTitle ?? ''},date:${article.data.publishedAt.toISOString().slice(0, 10)}`}
  >
    <div class="container narrow">
      <nav aria-label="breadcrumb" class="crumb">
        <a href="/">홈</a>
        <span aria-hidden="true">›</span>
        <a href={`/${article.data.cluster}`}>{cluster?.title}</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">{article.data.title.slice(0, 18)}…</span>
      </nav>

      <header class="article-header">
        {cluster && (
          <span class="cluster-tag" style={`--accent-light: ${cluster.accent}; --accent-dark: ${clusterAccentDark(cluster.accent)};`}>
            {cluster.shortTitle}
          </span>
        )}
        <h1>{article.data.title}</h1>
        <p class="lede">{article.data.description}</p>
        <div class="meta">
          <span class="byline">
            {authorProfileHref ? (
              <a href={authorProfileHref} rel="author">{authorName}</a>
            ) : (
              authorName
            )}
          </span>
          <span> · {dateStr} 발행</span>
          {updateStr && <span> · {updateStr} 갱신</span>}
          <span> · 데이터 기준 {article.data.dataValidAsOf}</span>
          <span class="reading-time" aria-label={`예상 읽기 시간 ${readingMinutes}분`}>
            · {readingMinutes}분 읽기
          </span>
        </div>
        {article.data.sources_verified && (
          <div class="verified-row">
            <SourceVerificationBadge
              verified={article.data.sources_verified}
              factsCount={article.data.verified_facts_count}
              approximateCount={article.data.approximate_facts_count}
              verificationAt={article.data.fact_verification_at}
            />
          </div>
        )}
      </header>

      <!-- 갱신 필요 배너 (180일 경과 시) -->
      {isStale && (
        <aside class={`stale-banner ${isVeryStale ? 'very-stale' : ''}`} role="status" aria-label="갱신 알림">
          <span class="icon" aria-hidden="true">{isVeryStale ? '⚠️' : '🕐'}</span>
          <div>
            <strong>{isVeryStale ? '1년 이상 갱신되지 않은 글입니다' : '6개월 이상 갱신되지 않은 글입니다'}</strong>
            <p>마지막 갱신 후 {ageMonths}개월 경과. 정책·요율은 변경됐을 수 있으니 신청 직전 공식 출처에서 재확인하세요.</p>
          </div>
        </aside>
      )}

      <!-- AI 인용 시나리오 (GEO 청킹) -->
      <aside class="cite-questions" aria-label="이 글이 다루는 질문">
        <h2>이 글이 다루는 질문</h2>
        <ul>
          {article.data.aiCitationQuestions.map((q) => <li>{q}</li>)}
        </ul>
      </aside>

      <!-- 본문 hero 일러스트 (perf: first-fold 아래 + content-visibility: auto) -->
      <HeroIllustration cluster={article.data.cluster} title={article.data.title} />

      <!-- 목차 (ToC) — H2 ≥ 3개일 때만 노출. AI 인용·스크린리더 내비게이션 강화. -->
      {tocItems.length >= 3 && (
        <nav class="toc" aria-label="이 글의 목차" data-pagefind-ignore>
          <p class="toc-label">목차</p>
          <ol>
            {tocItems.map((t) => (
              <li><a href={`#${t.slug}`}>{t.text}</a></li>
            ))}
          </ol>
        </nav>
      )}

      <!-- 본문 (MDX 렌더) -->
      <div class="prose">
        <Content />
      </div>

      <!-- FAQ -->
      {article.data.faq && article.data.faq.length > 0 && (
        <section class="faq">
          <h2>자주 묻는 질문</h2>
          {article.data.faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </section>
      )}

      <!-- 검증 상세 (자동 발행 글에만 노출) -->
      <VerificationDetails
        verified={article.data.sources_verified}
        factsCount={article.data.verified_facts_count}
        approximateCount={article.data.approximate_facts_count}
        verificationAt={article.data.fact_verification_at}
        aiLikeness={article.data.ai_likeness}
        dataValidAsOf={article.data.dataValidAsOf}
      />

      <!-- 출처 -->
      <section class="sources" id="sources">
        <h2>출처·참고자료</h2>
        <ul>
          {article.data.sources.map((s) => (
            <li><a href={s.url} rel="noopener noreferrer" target="_blank">{s.title}</a></li>
          ))}
        </ul>
        <p class="disclaimer">
          본 글의 정책·요율·법령은 변경될 수 있습니다. 신청 직전 위 공식 출처에서 재확인하세요.
          머니룩은 정부 1차 출처를 직접 확인해 작성·검수하며, 2026년 6월 이전 자동 발행분은 발행 당시 10단계 자동 검증 게이트(G0~G9)를 통과했습니다.
        </p>
      </section>

      <!-- smartdatashop network 메인 backref — 1차 출처 데이터 저널 funnel -->
      <MainBackrefBox variant="inline" cluster={article.data.cluster as never} />

      <!-- 저자 박스 — byline (bio 1~2문장 요약만, 전문은 author 프로필 페이지) -->
      <aside class="author-box" data-pagefind-ignore aria-label="저자 정보">
        <div class="author-box-row">
          <div class="author-avatar" aria-hidden="true">{authorName.slice(0, 1)}</div>
          <div class="author-box-body">
            <p class="author-name">
              {authorProfileHref ? (
                <a href={authorProfileHref} rel="author">{authorName}</a>
              ) : (
                authorName
              )}
              {authorEntry?.data.jobTitle && (
                <span class="author-job"> · {authorEntry.data.jobTitle}</span>
              )}
            </p>
            {authorBioSummary && <p class="author-bio">{authorBioSummary}</p>}
            {reviewLine && <p class="author-review">{reviewLine}</p>}
            {authorProfileHref && (
              <a class="author-more" href={authorProfileHref}>프로필 전체 보기 →</a>
            )}
          </div>
        </div>
      </aside>

      {relatedArticles.length > 0 && (
        <section class="related" data-pagefind-ignore>
          <h2>이 글과 함께 보면 좋은 글</h2>
          <div class="related-grid">
            {relatedArticles.map((a) => (
              <ArticleCard
                href={`/${a.data.cluster}/${a.id.replace(/\.mdx?$/, '')}/`}
                title={a.data.title}
                description={a.data.description}
                cluster={a.data.cluster}
                publishedAt={a.data.publishedAt}
              />
            ))}
          </div>
        </section>
      )}
    </div>
  </article>
</Base>

