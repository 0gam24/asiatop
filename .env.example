# 공공데이터포털 운영인증키 (data.go.kr) - 비밀
DATA_GO_KR_KEY=

# 법제처 국가법령정보 인증키 (law.go.kr) - 비밀
LAW_GO_KR_KEY=

# 한국은행 ECOS API 키 - 비밀
BOK_API_KEY=

# Google Analytics 4 측정 ID (예: G-XXXXXXXXXX) - 클라이언트 노출 OK
PUBLIC_GA4_ID=

# Google AdSense 게시자 ID (예: ca-pub-1234567890123456) - 클라이언트 노출 OK
PUBLIC_ADSENSE_CLIENT=

# Sentry DSN (예: https://abc@o000.ingest.sentry.io/000) - 클라이언트 노출 OK (DSN은 공개 키)
# 미설정 시 에러 추적 비활성. PROJECT.md §F: Sentry 무료 티어 (월 5K 에러).
PUBLIC_SENTRY_DSN=

# Sentry 환경 (production / preview / development) - 빌드 환경별 구분, 옵션
PUBLIC_SENTRY_ENV=production

# 빌드 시점에 주입되는 릴리스 식별자 (보통 Cloudflare Pages CF_PAGES_COMMIT_SHA 또는 git SHA)
# CF_PAGES_COMMIT_SHA=

# CF Deploy Hook URL - GitHub Actions Secrets에 등록 (코드/env에 직접 두지 말 것)
# CF_DEPLOY_HOOK=

# IndexNow 키 (고정 문자열, public/<key>.txt와 일치) - 비밀 X
# 현재 키: 6dc788531320b8af1f0844684208d55d (public/6dc788531320b8af1f0844684208d55d.txt 게시됨)
# GitHub Secrets에도 동일 키를 INDEXNOW_KEY로 등록
INDEXNOW_KEY=6dc788531320b8af1f0844684208d55d
