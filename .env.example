# ════════════════════════════════════════════════════════════════
# 머니룩 환경변수 — .env.local로 복사 후 채우세요
# .env.local은 .gitignore + pre-commit hook + CI gitleaks로 4중 차단
#
# 셋업: pnpm setup:env
# 가이드: docs/KEY-WALKTHROUGH.md
# 정책: SECURITY.md
# ════════════════════════════════════════════════════════════════

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 클라이언트 측 키 (PUBLIC_ prefix → 빌드 후 브라우저에 노출됨)
# 모두 공개 가능한 ID·DSN. 비밀 키 절대 X.
# 미설정 시 해당 기능만 비활성, 사이트는 정상 작동.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Google Analytics 4 측정 ID (예: G-XXXXXXXXXX)
# 발급: analytics.google.com → 속성 만들기 → 데이터 스트림 (5분)
PUBLIC_GA4_ID=

# Sentry DSN — 브라우저 JS 에러 추적
# 발급: sentry.io → Browser JavaScript 프로젝트 (10분, 무료 5K 에러/월)
PUBLIC_SENTRY_DSN=
PUBLIC_SENTRY_ENV=production

# Google AdSense 게시자 ID (예: ca-pub-1234567890123456)
# 발급: adsense.google.com (트래픽 누적 6개월+ 후 신청)
PUBLIC_ADSENSE_CLIENT=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# GitHub Actions 전용 (GitHub Secrets에만 등록, 로컬 X)
# 아래 값들은 참고용 — 실제 값은 GitHub Secrets에만 보관
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# CF Pages Deploy Hook URL (6시간 cron 자동 재빌드용)
# 발급: CF Pages → Settings → Builds & deployments → Deploy hooks
# 보관: GitHub Secrets only
# CF_DEPLOY_HOOK=

# IndexNow 키 (Bing·Yandex·Naver 즉시 색인)
# 자체 생성 32자 16진수 + public/<키>.txt에 같은 값 호스팅
# 보관: GitHub Secrets에 등록됨
INDEXNOW_KEY=6dc788531320b8af1f0844684208d55d
