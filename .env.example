# ════════════════════════════════════════════════════════════════
# 머니룩 환경변수 템플릿 — 이 파일을 .env.local로 복사 후 채우세요
# .env.local은 .gitignore로 보호되어 GitHub에 절대 올라가지 않습니다.
#
# 키 보관 위치 정책:
#  - 로컬 개발     → .env.local (이 파일 복사)
#  - 빌드(CF Pages) → Cloudflare Pages → Settings → Environment Variables
#  - GitHub Actions → GitHub repo → Settings → Secrets and variables → Actions
#
# 자세한 내용은 SECURITY.md 참조
# ════════════════════════════════════════════════════════════════

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🔒 빌드 타임 시크릿 (CF Pages env에 등록, 클라이언트 노출 X)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 공공데이터포털 운영인증키 (data.go.kr)
# 발급: data.go.kr 가입 → 활용신청 → 운영인증키 (1~2일 심사)
# 사용처: src/lib/api/data-go-kr.ts (청년정책·복지 데이터 빌드타임 fetch)
# ⭐ 반드시 "Decoding 키" 복사 (Encoding 키 X — URLSearchParams가 자동 인코딩)
#    Decoding 예: aBcD+eFgH/iJkL=...
#    Encoding 예: aBcD%2BeFgH%2FiJkL%3D... ← 이거 넣으면 이중 인코딩으로 인증 실패
DATA_GO_KR_KEY=

# 법제처 국가법령정보 인증키 (law.go.kr)
# 발급: law.go.kr 회원가입 → API 신청 (까다로움, 일반인 어려움)
# 사용처: 본문 인용 검증 (현재 미구현, URL 인용으로 대체)
LAW_GO_KR_KEY=

# 한국은행 ECOS API 키 (ecos.bok.or.kr)
# 발급: ecos.bok.or.kr/api 회원가입 → API 키 (즉시 발급, 5분)
# 사용처: 기준금리·환율 빌드타임 fetch (현재 미구현)
BOK_API_KEY=

# Google Analytics 4 Reporting API (인기글 자동 추출)
# 발급: cloud.google.com → 프로젝트 생성 → service account → JSON 키
# 사용처: src/lib/popularity.ts (인기글 추출, 현재 주석 처리)
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🌐 클라이언트 측 키 (PUBLIC_ prefix → 빌드 후 브라우저에 노출됨)
# 노출돼도 안전한 공개 키만 여기에. 절대 비밀 키 X.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Google Analytics 4 측정 ID (예: G-XXXXXXXXXX)
# 발급: analytics.google.com → 속성 만들기 → 데이터 스트림 → 측정 ID
# 사용처: src/components/Analytics.astro (Partytown 워커 격리)
PUBLIC_GA4_ID=

# Google AdSense 게시자 ID (예: ca-pub-1234567890123456)
# 발급: adsense.google.com → 사이트 추가 → 검토 후 (트래픽 누적 6개월+ 권장)
# 사용처: src/components/Analytics.astro
PUBLIC_ADSENSE_CLIENT=

# Sentry DSN (브라우저 에러 추적)
# 발급: sentry.io 가입 → 프로젝트 생성 (Browser SDK) → DSN 복사
# 사용처: src/lib/error-tracking.ts (lazy load, requestIdleCallback)
PUBLIC_SENTRY_DSN=
PUBLIC_SENTRY_ENV=production

# 빌드 시점 release 식별자 (보통 자동 주입)
# CF Pages가 자동으로 CF_PAGES_COMMIT_SHA 환경변수 제공
# CF_PAGES_COMMIT_SHA=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ⚙️ GitHub Actions 전용 (GitHub Secrets에만 등록, 로컬 X)
# 아래 값들은 .env.local에 넣을 필요 없음 (참고용으로만 명시)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Cloudflare Pages Deploy Hook URL — GitHub Secrets에만 등록
# 발급: CF Pages → moneylook → Settings → Builds & deployments → Deploy hooks
# 사용처: .github/workflows/scheduled-rebuild.yml (6시간 cron)
# CF_DEPLOY_HOOK=

# IndexNow Key (Bing·Yandex·Naver 즉시 색인용)
# 자체 생성: 32자 16진수 랜덤 문자열, public/<키>.txt에 같은 값 호스팅
# 현재 키: 6dc788531320b8af1f0844684208d55d
# 사용처: .github/workflows/indexnow.yml
INDEXNOW_KEY=6dc788531320b8af1f0844684208d55d

# Naver Search Advisor 토큰 (옵션)
# 발급: searchadvisor.naver.com (현재 미공개 API라 등록 권장 X)
# NAVER_SEARCH_ADVISOR_TOKEN=

# Bing Webmaster API 키 (옵션)
# 발급: bing.com/webmasters → API 키 (IndexNow가 사실상 대체)
# BING_API_KEY=

# Google Lighthouse CI App Token (옵션)
# 발급: github.com/apps/lighthouse-ci 설치
# LHCI_GITHUB_APP_TOKEN=
