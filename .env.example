# ════════════════════════════════════════════════════════════════════════
# 머니룩 환경변수 — 자동 Q&A 검증 사이트 (asiatop.co.kr)
# ════════════════════════════════════════════════════════════════════════
#
# 셋업:
#   cp .env.example .env.local
#   notepad .env.local       (또는 에디터로 직접 편집)
#   # 위에서 아래로 발급 순서대로 채워나가세요
#
# 보안 4-layer:
#   1. .gitignore (.env.local 차단)
#   2. pre-commit hook (시크릿 패턴 검사)
#   3. CI gitleaks (300+ 패턴)
#   4. 자체 secrets-scan.mjs (한국 공공 키)
#
# .env.local은 절대 git에 올라가지 않습니다. 키 누출 시 즉시 발급기관에서 폐기·재발급.
# ════════════════════════════════════════════════════════════════════════


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🎯 [1순위] LLM API — 자동 발행 핵심 (없으면 모든 게 멈춤)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 1-1. DeepSeek API (Pass 1 초안 생성)
# 발급: https://platform.deepseek.com → 회원가입 → API Keys → Create
# 비용: 종량제 약 $0.014/편 (1편당 3K input + 2K output 추정)
# 충전: $5~10 충전으로 첫 한 달 운영 가능
DEEPSEEK_API_KEY=

# 1-2. Anthropic Claude API (Pass 3 자연화)
# 발급: https://console.anthropic.com → Settings → API Keys → Create Key
# 비용: 종량제 약 $0.008/편 (Claude Haiku 4.5 사용)
# 충전: $5 크레딧 충전으로 첫 달 충분
ANTHROPIC_API_KEY=


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🔍 [2순위] 네이버 검색 API — 지식인 질문 수집
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 2-1·2-2. 네이버 OpenAPI (지식iN·카페글 검색)
# 발급: https://developers.naver.com → 애플리케이션 등록
#   · Application 이름: 머니룩
#   · 사용 API: 검색 (지식iN, 카페글)
#   · 환경: WEB / Callback URL: https://asiatop.co.kr
# 비용: 무료 (일 25,000건 한도 — 충분)
# 즉시 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 📊 [3순위] 권위 데이터 API — 사실 검증 (G3·G4 게이트)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 7개 cluster 검증에 필요. 우선순위 순서대로:
# gov-support·tax·realestate·unemployment·savings·insurance-labor·pension
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 3-1. 공공데이터포털 (정부 데이터 — gov-support·public-services·realestate)
# 발급: https://www.data.go.kr → 회원가입(이메일 인증) → 검색창에 사용할 데이터셋 검색
#   · 시드 데이터셋: "청년정책 통합조회" "복지서비스 목록" "국토교통부 분양정보"
#   · 활용신청 → 활용 목적: "미디어 사이트 머니룩(asiatop.co.kr) 자동 발행 검증"
#   · 일반 인증키 즉시 발급 / 운영 인증키 1~2일 (권장: 일 10,000회)
# ⚠️  반드시 "Decoding 키" 복사 (Encoding 키는 이중 인코딩 발생)
# 비용: 무료
DATA_GO_KR_KEY=

# 3-2. 한국은행 ECOS API (savings·credit-loan — 기준금리·예금금리)
# 발급: https://ecos.bok.or.kr/api → 회원가입 → "OPEN API 인증키 신청"
#   · 신청 사유: "정보 사이트 머니룩 금리·환율 데이터 인용"
#   · 즉시 발급 (24자 영숫자 키)
# 비용: 무료 (일 10,000건)
BOK_API_KEY=

# 3-3. 법제처 OpenAPI (tax·insurance-labor·office-tips·unemployment — 법령)
# 발급: https://www.law.go.kr/DRF/openAPI.do → 회원가입 → "이메일 인증"
#   · OC 발급 = 가입 시 입력한 이메일 ID 부분 (@ 앞)
#   · 별도 신청 X — 가입과 동시에 OC 사용 가능
# 비용: 무료 (rate-limit 30 req/s)
LAW_GO_KR_OC=

# 3-4. 고용24 OpenAPI (unemployment — 실업급여·구직급여)
# 발급: https://www.work24.go.kr → 개발자센터 → API 인증키 신청
#   · 활용 데이터: "구직급여 산정", "직업훈련 정보", "고용24 채용 검색"
#   · 활용 목적: "미디어 사이트 머니룩 실업급여 정보 인용"
#   · 1일 1,000건 (개발), 10,000건 (운영) 신청 가능
# 비용: 무료
WORK24_KEY=

# 3-5. 국민연금공단 OpenAPI (pension — 노령연금·임의가입·수령액)
# 발급: https://www.nps.or.kr → 정보공개 → OpenAPI 신청
#   · 활용 데이터: "노령연금 예상수령액", "가입자 통계"
#   · 활용 목적: 동상
# 비용: 무료 (일 1,000건)
NPS_KEY=

# 3-6. 금감원 finlife OpenAPI (savings·credit-loan·insurance-personal·auto)
# 발급: https://finlife.fss.or.kr/finlife/main/main.do → 우상단 OpenAPI → 인증키 신청
#   · 활용 데이터: "정기예금·신용대출·자동차보험 비교공시"
#   · 활용 목적: 동상
# 비용: 무료 (일 1,000건)
FSS_KEY=


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ⚙️ [4순위] 토글 — Mock vs Real API 모드
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# MOCK_AUTHORITY:
#   1 (default) → fixture 응답 사용 (CI·로컬 dev 안전 모드)
#   0 → 실 API 호출 (production cron 전용)
#
# 위 [3순위] 키 모두 발급 + GitHub Secrets·CF Pages Env 등록 완료 후 0으로 토글.
# CF Pages Env는 별도. 로컬 dev에서 실 API 테스트 시 .env.local에서 0으로.
MOCK_AUTHORITY=1

# 발급 진행 단계별 토글 권장:
# Day 1 (키 발급 직후)        → 1 (mock 모드 유지)
# Day 1 (workflow_dispatch)   → 0 (1회 dry-run으로 실 API 검증)
# Day 2~                       → 0 (cron 자동 활성)


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🚀 [5순위] 색인·배포 자동화
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 5-1. IndexNow 키 (Bing·Yandex·Naver 즉시 색인)
# 자체 생성: 32자 16진수 (예: openssl rand -hex 16)
# 키 파일 게시: public/<키>.txt 에 같은 값 1줄 (이미 작업 완료)
# GitHub Secrets에도 등록 (.github/workflows/indexnow.yml 사용)
INDEXNOW_KEY=6dc788531320b8af1f0844684208d55d

# 5-2. Cloudflare Pages Deploy Hook (6시간 cron 자동 재빌드)
# 발급:
#   dash.cloudflare.com → Pages → moneylook
#   → Settings → Builds & deployments → Deploy hooks
#   → Add deploy hook (이름: cron-rebuild)
#   → 발급된 URL 복사 (한 번만 노출됨)
# 보관: GitHub Secrets only (.env.local에 저장하지 말 것 — 6h cron만 사용)
# CF_DEPLOY_HOOK=  # GitHub Secrets에만 등록


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 📈 [6순위] 분석·모니터링 (PUBLIC_ prefix → 빌드 후 브라우저 노출)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PUBLIC_ 접두사 = 클라이언트 노출 OK (공개 ID·DSN). 비밀 키 절대 X.
# 미설정 시 해당 기능만 비활성, 사이트는 정상 작동.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 6-1. Google Analytics 4
# 발급: https://analytics.google.com → 속성 만들기 → 데이터 스트림
#   · 속성 이름: 머니룩 / 시간대: 한국 / 통화: KRW
#   · URL: https://asiatop.co.kr → 측정 ID (G- 시작 10자) 복사
# 5분 / 무료
PUBLIC_GA4_ID=

# 6-2. Sentry — 브라우저 JS 에러 추적
# 발급: https://sentry.io → Browser JavaScript 프로젝트 생성
#   · 프로젝트 이름: moneylook
#   · Settings → Client Keys (DSN) → DSN 복사
# 10분 / 무료 5,000 에러/월
PUBLIC_SENTRY_DSN=
PUBLIC_SENTRY_ENV=production

# 6-3. Google AdSense — 게시자 ID
# ⚠️  발급 시점: 사이트 트래픽 누적 6개월+ 후 (현재는 X)
# 자동 발행 시작 후 6개월 (≈ 2026년 11월) 신청 권장
# 발급: https://www.google.com/adsense → 가입 → asiatop.co.kr 추가
#   · 게시자 ID: ca-pub-XXXXXXXXXXXXXXXX (16자 숫자)
PUBLIC_ADSENSE_CLIENT=


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🔧 [선택] GA4 Reporting API — 인기글 자동 추출 (V2)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 운영 1개월 후 트래픽 데이터 누적되면 발급 검토. 현재는 발급 불필요.
# 발급: console.cloud.google.com → API 사용 설정 → "Google Analytics Data API"
#   → 서비스 계정 생성 → JSON 키 다운로드 → 한 줄로 변환
# GA4_PROPERTY_ID=
# GA4_SERVICE_ACCOUNT_JSON=


# ════════════════════════════════════════════════════════════════════════
# 📌 발급·등록 절차 요약 (위에서 아래 순서대로)
# ════════════════════════════════════════════════════════════════════════
#
# 1. 위 키들을 .env.local에 채워넣기 (로컬 개발용)
# 2. 같은 키들을 GitHub Secrets·CF Pages Env에 등록 (production용)
#    · GitHub: github.com/0gam24/moneylook → Settings → Secrets and variables → Actions
#    · CF Pages: dash.cloudflare.com → Pages → moneylook → Settings → Variables and Secrets
# 3. 발급 완료된 키부터 순서대로:
#    [1순위 LLM] → [2순위 NAVER] → [3순위 권위 7종] → [5순위 INDEXNOW·CF Hook] → [6순위 GA4·Sentry]
# 4. 모든 키 등록 후 MOCK_AUTHORITY=0 토글 (CF Pages vars 또는 GitHub vars)
# 5. workflow_dispatch + dry_run=true 1회 → 게이트 trace 정상 출력 확인
# 6. dry_run=false → 첫 자동 발행 PR 생성·머지·라이브
#
# 예상 첫 발행: 키 발급 시작 후 2~4시간.
# 자세한 절차: docs/AUTO-PUBLISH-GUIDE.md
# ════════════════════════════════════════════════════════════════════════
