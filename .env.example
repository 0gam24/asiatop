# ════════════════════════════════════════════════════════════════════════
# 머니룩 환경변수 — 수동 발행 정적 사이트 (asiatop.co.kr)
# ════════════════════════════════════════════════════════════════════════
#
# 셋업: cp .env.example .env.local
#
# 2026-06-11 자동 발행 파이프라인 폐기 — LLM·지식인 수집·정부 API 검증 키
# 전부 제거 (git 히스토리에서 복구 가능). 현재는 색인·배포·분석 키만 사용.
# 보안 4-layer (.gitignore + pre-commit + CI gitleaks + secrets-scan).
# ════════════════════════════════════════════════════════════════════════


# ════════════════════════════════════════════════════════════════════════
# 🚀 색인·배포
# ════════════════════════════════════════════════════════════════════════

# IndexNow (Bing·Yandex·Naver 즉시 색인)
# 발급: 자체 생성 32자 hex (이미 발급 완료, public/<키>.txt 게시 완료)
# 보관: GitHub Secrets에도 등록 (.github/workflows/indexnow.yml 사용)
INDEXNOW_KEY=6dc788531320b8af1f0844684208d55d

# Cloudflare Pages Deploy Hook (6h cron 자동 재빌드)
# 사이트 URL: https://dash.cloudflare.com → Pages → moneylook
# 발급 절차:
#   1) Settings → Builds & deployments → Deploy hooks
#   2) Add deploy hook (이름: cron-rebuild, Branch: main)
#   3) 발급된 URL 복사 (한 번만 노출)
# 보관: GitHub Secrets only (.env.local에 저장하지 말 것 — cron만 사용)
# CF_DEPLOY_HOOK=  # GitHub Secrets에만 등록


# ════════════════════════════════════════════════════════════════════════
# 📈 분석·모니터링 (PUBLIC_ prefix → 빌드 후 브라우저 노출)
# ════════════════════════════════════════════════════════════════════════
# PUBLIC_ 접두사 = 클라이언트 노출 OK (공개 ID·DSN). 비밀 키 절대 X.
# 미설정 시 해당 기능만 비활성, 사이트는 정상 작동.
# ════════════════════════════════════════════════════════════════════════

# Google Analytics 4 — https://analytics.google.com
# 측정 ID (G-XXXXXXXXXX, 10자)
PUBLIC_GA4_ID=

# Sentry (브라우저 JS 에러 추적) — https://sentry.io
# Settings → Client Keys (DSN) → DSN 복사. 무료 5,000 에러/월
PUBLIC_SENTRY_DSN=
PUBLIC_SENTRY_ENV=production

# Google AdSense (asiatop.co.kr 승인 완료 — 2026-05-22)
# 게시자 ID (pub-XXXXXXXXXXXXXXXX, 16자)
# Auto ads 단독 운영 — 수동 유닛(slot ID) 은 2026-08-25 전면 철거.
# 이 값이 유일한 광고 스위치: 비우면 전체 광고 송출 중단.
PUBLIC_ADSENSE_CLIENT=


# ════════════════════════════════════════════════════════════════════════
#  검색 엔진 소유권 인증 (R49 #49-2)
#  GSC·Naver Search Advisor·Bing Webmaster Tools 등록 시 발급되는 메타 토큰.
#  값 미설정 시 meta tag 자체 생략 (build 영향 0).
#  PUBLIC_ prefix: 클라이언트 노출 허용 — head meta는 공개 정보.
# ════════════════════════════════════════════════════════════════════════

# Google Search Console — https://search.google.com/search-console
# 발급: 도메인 등록 → "HTML 태그" 인증 방식 → content="..." 값
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Naver Search Advisor — https://searchadvisor.naver.com
# 발급: 사이트 추가 → "HTML 태그" 인증 방식 → content="..." 값
PUBLIC_NAVER_SITE_VERIFICATION=

# Bing Webmaster Tools — https://www.bing.com/webmasters
# 발급: 사이트 추가 → "메타 태그" 인증 방식 → content="..." 값 (msvalidate.01)
PUBLIC_BING_SITE_VERIFICATION=
# ════════════════════════════════════════════════════════════════════════
