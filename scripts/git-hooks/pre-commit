#!/usr/bin/env bash
# 머니룩 pre-commit hook
# 시크릿·API 키가 실수로 커밋되는 것을 차단.
# 설치: pnpm prepare (package.json scripts 자동 실행) 또는
#      git config core.hooksPath scripts/git-hooks
set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

echo "🔒 시크릿 사전 점검..."

# 1. 차단할 파일명 패턴
BLOCKED_FILES_REGEX='(^|/)(\.env(\.local|\.production|\.development|\.[a-z]+\.local)?$|credentials\.json$|service-account.*\.json$|gcp-key.*\.json$|.*\.pem$|.*\.p12$|.*\.pfx$|aws-credentials$|.*\.secret$|.*\.secrets$|.*-secret\..*)'

# 2. 차단 예외 (example 파일은 OK)
ALLOWED_FILES_REGEX='\.env(\.local)?\.example$|\.env\.example$'

# 3. 본문 내 시크릿 패턴 (False positive 줄이려고 길고 명확한 것만)
SECRET_PATTERNS=(
  # AWS
  'AKIA[0-9A-Z]{16}'                                         # AWS Access Key
  'aws_secret_access_key\s*=\s*["\047]?[A-Za-z0-9/+=]{40}'   # AWS Secret

  # GCP
  '"private_key":\s*"-----BEGIN [A-Z ]+PRIVATE KEY-----'      # GCP service account JSON

  # Google·Firebase
  'AIza[0-9A-Za-z_-]{35}'                                     # Google API Key

  # GitHub
  'gh[pousr]_[A-Za-z0-9_]{36,}'                              # GitHub Personal Access Token

  # Cloudflare
  'CLOUDFLARE_API_TOKEN\s*=\s*["\047]?[A-Za-z0-9_-]{40}'

  # Stripe
  'sk_live_[A-Za-z0-9]{24,}'
  'rk_live_[A-Za-z0-9]{24,}'

  # Anthropic·OpenAI
  'sk-ant-api[0-9]{2}-[A-Za-z0-9_-]{80,}'                    # Anthropic
  'sk-[A-Za-z0-9]{48,}'                                       # OpenAI

  # 한국 공공·금융
  'DATA_GO_KR_KEY\s*=\s*["\047]?[A-Za-z0-9%/+=]{40,}'         # 공공데이터포털
  'BOK_API_KEY\s*=\s*["\047]?[A-Za-z0-9]{30,}'                # 한국은행 ECOS

  # Cloudflare Pages Deploy Hook (URL 패턴)
  'webhooks/deploy_hooks/[a-f0-9-]{36}'

  # 일반 high-entropy
  '(api_key|apikey|secret|password|passwd|token|access_token|refresh_token|private_key)\s*[:=]\s*["\047][A-Za-z0-9_/+=-]{32,}["\047]'
)

EXIT_CODE=0

# 스테이징된 파일 목록
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$STAGED_FILES" ]; then
  echo -e "${GREEN}✓ 스테이징된 파일 없음${NC}"
  exit 0
fi

# (1) 파일명 차단
echo "$STAGED_FILES" | while IFS= read -r f; do
  if [ -z "$f" ]; then continue; fi

  if echo "$f" | grep -qE "$BLOCKED_FILES_REGEX"; then
    if echo "$f" | grep -qE "$ALLOWED_FILES_REGEX"; then
      continue
    fi
    echo -e "${RED}❌ 차단: 비밀 파일이 커밋 대상에 포함${NC}"
    echo -e "   파일: ${YELLOW}$f${NC}"
    echo -e "   해제: git reset HEAD '$f' (스테이징 취소)"
    exit 1
  fi
done || EXIT_CODE=1

# (2) 본문 시크릿 패턴 스캔
for f in $STAGED_FILES; do
  if [ ! -f "$f" ]; then continue; fi

  # 텍스트 파일만 스캔 (바이너리 패스)
  if ! file -b --mime-encoding "$f" 2>/dev/null | grep -qE 'utf-8|ascii|us-ascii'; then
    continue
  fi

  for pattern in "${SECRET_PATTERNS[@]}"; do
    if grep -EnH "$pattern" "$f" 2>/dev/null; then
      echo -e "${RED}❌ 차단: 시크릿 패턴 발견${NC}"
      echo -e "   파일: ${YELLOW}$f${NC}"
      echo -e "   패턴: $pattern"
      echo -e "   해결: 해당 값을 .env.local로 옮기고 import.meta.env로 참조"
      EXIT_CODE=1
    fi
  done
done

if [ $EXIT_CODE -ne 0 ]; then
  echo ""
  echo -e "${RED}🛑 커밋 차단됨 — 시크릿 노출 방지${NC}"
  echo -e "${YELLOW}   .env.local·CF Pages Env·GitHub Secrets에 보관하고${NC}"
  echo -e "${YELLOW}   코드에서는 import.meta.env / \${{ secrets.X }}만 참조하세요.${NC}"
  echo -e "${YELLOW}   상세: SECURITY.md${NC}"
  exit $EXIT_CODE
fi

echo -e "${GREEN}✅ 시크릿 점검 통과${NC}"
exit 0
