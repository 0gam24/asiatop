# ─────────────────────────────────────────────
# 환경변수 파일 (실제 키 보관)
.env
.env.local
.env.*.local
.env.production
.env.development
!.env.example
!.env.local.example

# 인증서·키 파일
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
*.jks
*.keystore

# 클라우드·API 자격증명
